  - m_Id: 50606298271764
    m_Localized: "\u25CF {em:\u52C7\u8005\u306E\u5263}\u5C02\u7528\u306E\u907A\u7269\r\n\u25CF
      \u56DE\u8EE2\u65AC\u308A\u306E\u30C1\u30E3\u30FC\u30B8\u4E2D\u306B{pos:\u7A81\u9032\u7A81\u304D\u304C\u4F7F\u7528\u53EF\u80FD}\r\n\u25CF
      \u767A\u52D5\u6642\u306E\u30C1\u30E3\u30FC\u30B8\u91CF\u306B\u5FDC\u3058\u3066\u7A81\u304D\u306E\u30C0\u30E1\u30FC\u30B8\u30FB\u30B5\u30A4\u30BA\u30FB\u8272\u304C\u5909\u5316\r\n\u25CF
      \u6700\u5927\u30C1\u30E3\u30FC\u30B8\u6642\u3001\u7A81\u304D\u306E\u30C0\u30E1\u30FC\u30B8\u7D04{val:1.67\u500D}\r\n\u25CF
