  - m_Id: 50606285688877
    m_Localized: "\u3088\u308D\u3081\u304D\u5024"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688878
    m_Localized: "\u5263\u3092\u9023\u7D9A\u3067\u632F\u308B\u3046\u3002\u6700\u5F8C\u306E\u653B\u6483\u306F\u524D\u9032\u3057\u306A\u304C\u3089\u5927\u304D\u304F\u65AC\u308A\u6255\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688879
    m_Localized: "\u25CF \u5263\u3092\u632F\u308B\u3063\u3066{val:3\u9023\u7D9A}\u306E\u8FD1\u63A5\u653B\u6483\r\n\u25CF
      3\u6483\u76EE\u306F\u3088\u308A\u9060\u304F\u3078\u524D\u9032\u3057\u3001\u5927\u304D\u304F\u65AC\u308A\u6255\u3046"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688880
    m_Localized: "\u9577\u62BC\u3057\u3057\u3066\u96E2\u3059\u3068\u3001\u56DE\u8EE2\u3057\u3066\u5468\u56F2\u3092\u65AC\u308B\u3002\u5341\u5206\u306A\u30C1\u30E3\u30FC\u30B8\u304C\u5FC5\u8981\u3067\u3001\u9577\u304F\u6E9C\u3081\u308B\u307B\u3069\u7BC4\u56F2\u3068\u5A01\u529B\u304C\u5897\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688881
    m_Localized: "\u25CF \u9577\u62BC\u3057\u3067\u6E9C\u3081\u3001\u96E2\u3059\u3068{em:\u56DE\u8EE2\u65AC\u308A}\r\n\u25CF
      50%\u4EE5\u4E0B\u3067\u96E2\u3059\u3068\u30AD\u30E3\u30F3\u30BB\u30EB\u300150%\u3092\u8D85\u3048\u308B\u3068\u653B\u6483\r\n\u25CF
      \u6E9C\u3081\u308B\u307B\u3069{pos:\u30C0\u30E1\u30FC\u30B8\u3068\u653B\u6483\u7BC4\u56F2\u304C\u5897\u52A0}\r\n\u25CF
      \u6700\u5927\u30C1\u30E3\u30FC\u30B8\u6642\u306F\u6700\u5C0F\u6642\u306B\u6BD4\u3079\u3001\u30C0\u30E1\u30FC\u30B8\u7D04{val:1.67\u500D}\u3001\u653B\u6483\u30B5\u30A4\u30BA{val:2\u500D}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688882
    m_Localized: "\u72D9\u3063\u305F\u65B9\u5411\u3078\u7A81\u9032\u3057\u3001\u524D\u65B9\u306E\u6575\u3092\u7A81\u304F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688883
    m_Localized: "\u25CF \u72D9\u3063\u305F\u65B9\u5411\u3078{em:\u7A81\u9032}\u3057\u3001\u524D\u65B9\u306E\u6575\u3092\u7A81\u304F"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688884
    m_Localized: "\u706B\u708E\u5F3E\u3092\u653E\u3061\u3001\u7740\u5F3E\u5730\u70B9\u306E\u5468\u56F2\u306B\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u3066[[\uD654\uC0C1]]\u3092\u4ED8\u4E0E\u3059\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688885
    m_Localized: "\u25CF \u72D9\u3063\u305F\u65B9\u5411\u306B\u706B\u708E\u5F3E\u3092\u767A\u5C04\r\n\u25CF
      \u7740\u5F3E\u5730\u70B9\u5468\u56F2\u306B[[\uD654\uC5FC \uD53C\uD574]]\u5206\u306E\u7BC4\u56F2\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u3001[[\uD654\uC0C1]]\u3092{val:3\u30B9\u30BF\u30C3\u30AF}\u4ED8\u4E0E"
    m_Metadata:
