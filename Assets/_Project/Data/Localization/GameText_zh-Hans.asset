    m_Localized: "\u25CF [[\uD654\uC0C1]]\u6D88\u8017\u95F4\u9694{{pos:\u51CF\u5C11{0:0}%}}\uFF08\u95F4\u9694{{val:{1:0.##}\u79D2}}\uFF09"
