  - m_Id: 102995747311667
    m_Localized: "\uCD9C\uD608 \uD53C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 102995747311668
    m_Localized: "\uAE30\uBCF8\uACF5\uACA9 \uD53C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 102995747311669
    m_Localized: "\uC2A4\uD0AC \uD53C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 102995747311670
    m_Localized: "\uCD5C\uB300 \uCCB4\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 102995747311671
    m_Localized: "\uCD5C\uC885 \uD53C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 102995747311672
    m_Localized: "\uD68C\uD53C\uC728"
    m_Metadata:
      m_Items: []
  - m_Id: 102995747311673
    m_Localized: "\uCE58\uBA85\uD0C0 \uD53C\uD574"
    m_Metadata:
      m_Items: []
  - m_Id: 139231648190464
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC\uB85C \uAC00\uC838\uC624\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 139235322400768
    m_Localized: "\uBC84\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 139235322400769
    m_Localized: "[R] \uB9AC\uB864 {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 139235322400770
    m_Localized: "\uD53C\uD574 {0}/{1}\nDPS {2}/{3}\n\uB204\uC801 {4}"
    m_Metadata:
      m_Items: []
  - m_Id: 139235322400771
    m_Localized: "\uC220\uC5D0 \uBD99\uC740 \uBD88\uAE38"
    m_Metadata:
      m_Items: []
  - m_Id: 139235322400772
    m_Localized: "{0} \uAE38\uAC8C \uB204\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 139235322400773
    m_Localized: "\uB3C4\uAC10"
    m_Metadata:
      m_Items: []
  - m_Id: 139235322400774
    m_Localized: "\uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 139235322400775
    m_Localized: "WASD\uB97C \uB20C\uB7EC \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 139235322400776
    m_Localized: "\uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 139235322400777
    m_Localized: "SPACE\uB97C \uB20C\uB7EC \uC9E7\uC740 \uAC70\uB9AC\uB97C \uC8FC\uD30C\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595072
    m_Localized: "\uC804\uD22C"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595073
    m_Localized: "\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uD074\uB9AD\uC744 \uD1B5\uD574
      \uACF5\uACA9\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595074
    m_Localized: "\uC804\uD22C"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595075
    m_Localized: "\uB9C8\uC6B0\uC2A4 \uC6B0\uD074\uB9AD, Q\uD0A4\uB97C \uB20C\uB7EC
      \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595076
    m_Localized: "\uC0C1\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595077
    m_Localized: "\uC804\uD22C\uAC00 \uC885\uB8CC\uB418\uBA74 \uC0C1\uC790\uC5D0
      \uC811\uADFC\uD574 F\uD0A4\uB97C \uB20C\uB7EC \uAC1C\uBC29\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595078
    m_Localized: "\uC544\uC774\uD15C"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595079
    m_Localized: "\uC0C1\uC790 \uC548\uC5D0\uB294 \uB2E4\uC591\uD55C \uC544\uC774\uD15C\uC774
      \uC874\uC7AC\uD558\uBA70, \uB2E4\uC591\uD55C \uB2A5\uB825\uC744 \uAC00\uC9C0\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595080
    m_Localized: "\uAC8C\uC774\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595081
    m_Localized: "\uD55C \uB9F5\uC758 \uB05D\uC5D0\uB294 \uB2E4\uC74C \uB9F5\uC73C\uB85C
      \uAC00\uB294 \uAC8C\uC774\uD2B8\uAC00 \uC874\uC7AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595082
    m_Localized: "\uAC8C\uC774\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595083
    m_Localized: "\uAC8C\uC774\uD2B8\uC5D0 \uC811\uADFC\uD574 F\uD0A4\uB97C \uB20C\uB7EC
      \uC0C1\uD638\uC791\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595084
    m_Localized: "\uD53C\uD574\uB97C \uBC1B\uC73C\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595085
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595086
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595087
    m_Localized: "\uD53C\uD574\uB97C \uBC1B\uC73C\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595088
    m_Localized: "\uD53C\uD574\uB97C \uBC1B\uC73C\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595089
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595090
    m_Localized: "\uD53C\uD574\uB97C \uBC1B\uC73C\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595091
    m_Localized: "\u25CF [[\uD654\uC0C1]] \uC0C1\uD0DC\uC778 \uC801\uC5D0\uAC8C [[\uCE58\uBA85\uD0C0]]
      \uC801\uC911 \uC2DC [[\uD654\uC0C1]] {burn_stacks}\uC911\uCCA9 \uBD80\uC5EC\n\u25CF
      \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04 {cooldown}"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595092
    m_Localized: "\u25CF [[\uCE58\uBA85\uD0C0]] \uC801\uC911 \uC2DC {duration} \uB3D9\uC548
      [[\uCE58\uBA85\uD0C0 \uD655\uB960]] {chance}\n\u25CF \uCE58\uBA85\uD0C0 \uC7AC\uC801\uC911
      \uC2DC {pos:\uC9C0\uC18D \uC2DC\uAC04 \uAC31\uC2E0}"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595093
    m_Localized: "\u25CF \uCE58\uBA85\uD0C0\uAC00 \uC544\uB2CC \uACF5\uACA9 \uC801\uC911
      \uC2DC [[\uCE58\uBA85\uD0C0 \uD655\uB960]] {chance_per_stack}\n\u25CF \uCD5C\uB300
      {maximum_stacks}\uD68C \uC911\uCCA9, \uCD1D {maximum_chance}\n\u25CF \uCE58\uBA85\uD0C0
      \uBC1C\uC0DD \uC2DC {neg:\uB204\uC801 \uBCF4\uB108\uC2A4 \uCD08\uAE30\uD654}"
    m_Metadata:
      m_Items: []
  - m_Id: 141504407310336
    m_Localized: "\uAE38\uC7A1\uC774 \uC2AC\uB77C\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 141504524750848
    m_Localized: "\uAC74\uC124 \uC2AC\uB77C\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 178007384690688
    m_Localized: "\uD50C\uB808\uC774 \uD0C0\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 178007489548288
    m_Localized: "\uC5C5\uADF8\uB808\uC774\uB4DC \uC9C4\uD589\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 178007489548289
    m_Localized: "\uBCF4\uC720 \uB9C8\uC815\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 178007489548290
    m_Localized: "\uD074\uB9AC\uC5B4 \uD69F\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 179015443714048
    m_Localized: "\uC2AC\uB86F 1"
    m_Metadata:
      m_Items: []
  - m_Id: 179015556960256
    m_Localized: "\uC2AC\uB86F 2"
    m_Metadata:
      m_Items: []
  - m_Id: 179015556960257
    m_Localized: "\uC2AC\uB86F 3"
    m_Metadata:
      m_Items: []
  - m_Id: 192954411945984
    m_Localized: "\uD06C\uC73D.."
    m_Metadata:
      m_Items: []
  - m_Id: 192956131610624
    m_Localized: "...\uC774\uAC74 \uC880 \uC544\uD50C\uAC70\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 192956131610625
    m_Localized: "\uCC0C\uB978\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956131610626
    m_Localized: "\uC798 \uBCF4\uACE0 \uD53C\uD574\uBD10!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956131610627
    m_Localized: "\uBCA0\uC5B4\uC8FC\uB9C8!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956131610628
    m_Localized: "\uC774\uAC74 \uB9DE\uC73C\uBA74 \uC9C4\uC9DC \uC544\uD30C?"
    m_Metadata:
      m_Items: []
  - m_Id: 192956144193536
    m_Localized: "\uB358\uC9C4\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387840
    m_Localized: "\uC5B4\uB514\uAE4C\uC9C0 \uB3C4\uB9DD\uAC00\uB098 \uBCFC\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387841
    m_Localized: "\uC5B4\uB514\uD55C\uBC88 \uD53C\uD574\uBCF4\uC2DC\uC9C0!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387842
    m_Localized: "\uD130\uC838\uBCFC\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387843
    m_Localized: "\uCC29\uC9C0\uD55C\uB2E4, \uBE44\uCF1C!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387844
    m_Localized: "\uBE44\uCF1C! \uC560\uC1A1\uC774!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387845
    m_Localized: "\uB3CC\uC544\uC640, \uC544\uC9C1 \uC548 \uB05D\uB0AC\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387846
    m_Localized: "\uC774\uB9AC\uC640!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387847
    m_Localized: "\uC7A1\uD788\uBA74 \uC8FD\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387848
    m_Localized: "\uBC29\uC2EC\uD588\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387849
    m_Localized: "\uC7A5\uB09C\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387850
    m_Localized: "\uC870\uAE08 \uC9C4\uC2EC\uC744 \uB0B4\uBCFC\uAE4C"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387851
    m_Localized: "\uC57C\uC57C\uC57C, \uB358\uC9C0\uC9C0 \uB9C8!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387852
    m_Localized: "\uC124\uB9C8 \uB610 \uB358\uC9C0\uB824\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387853
    m_Localized: "\uC7A0\uAE50, \uB098 \uC900\uBE44 \uC548 \uB410\uB294\uB370?!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387854
    m_Localized: "\uC774\uC81C \uC640\uC11C \uBD80\uB974\uB0D0?!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387855
    m_Localized: "\uADF8\uB798\uADF8\uB798, \uC5C6\uC73C\uBA74 \uC548 \uB418\uACA0\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387856
    m_Localized: "\uD765, \uC774\uBC88\uB9CC \uB3C4\uC640\uC900\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387857
    m_Localized: "\uADF8\uB798, \uACB0\uAD6D \uB0B4\uAC00 \uD544\uC694\uD558\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387858
    m_Localized: "\uC73C\uC544\uC544\uC544\uC544\uC545!!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387859
    m_Localized: "\uD55C \uB9C8\uB514\uB9CC \uB354\uD574\uB77C"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387860
    m_Localized: ....
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387861
    m_Localized: "\uC6B0\uC6E9.."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387862
    m_Localized: "\uAC10\uD788.. \uC774 \uBAB8\uC744.."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387863
    m_Localized: "\uD22C\uCC99\uC6A9 \uAC80\uC774 \uC544\uB2C8\uB77C\uACE0!!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387864
    m_Localized: "\uC220\uC774... \uBAA8\uC790\uB77C..."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387865
    m_Localized: "\uB4E4\uC774\uD0A8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387866
    m_Localized: "\uD06C\uC73C~ \uCDE8\uD55C\uB2E4~!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387867
    m_Localized: "\uC74C~ \uC88B\uB2E4~"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387868
    m_Localized: "\uC557 \uB728\uAC70!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387869
    m_Localized: "\uC5B4\uC9C8\uC5B4\uC9C8\uD558\uAD70..."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387870
    m_Localized: "\uC798 \uD53C\uD574\uBD10~"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387871
    m_Localized: "\uC5F4\uB9AC\uC9C0 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387872
    m_Localized: "\uAD73\uAC8C \uC7A0\uACA8\uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387873
    m_Localized: "\uB2E4\uB978 \uC7A5\uCE58\uAC00 \uC788\uC744 \uC218\uB3C4 \uC788\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387874
    m_Localized: "\uC7A5\uBE44 \uCE78\uC774 \uAC00\uB4DD \uCC3C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387875
    m_Localized: "\uBE48 \uCE78\uC744 \uB9CC\uB4E4\uC5B4\uC57C \uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387876
    m_Localized: "\uC9C0\uAE08\uC740 \uB354 \uBABB \uC90D\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387877
    m_Localized: "\uC774\uCABD\uC5D0\uC120 \uC548\uC5F4\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387878
    m_Localized: "\uBC18\uB300\uD3B8\uC5D0\uC11C \uC5F4 \uC218 \uC788\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387879
    m_Localized: "\uB124\uAC00 \uB2E4\uCE58\uC9C0 \uC54A\uC544\uC11C \uB2E4\uD589\uC774\uC57C.."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387880
    m_Localized: "...\uC774\uAC74 \uC880 \uC544\uD50C\uAC70\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387881
    m_Localized: "\uBAA8\uB450 \uBAA8\uC5EC\uB77C!!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387882
    m_Localized: "\uAD50\uB300\uD574\uC918!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387883
    m_Localized: "\uC624\uCF00\uC774!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387884
    m_Localized: "\uC544\uC57C\uC57C\u2026 \uAC10\uD788 \uD53C\uD558\uB2E4\uB2C8!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387885
    m_Localized: "\uC6B0\uC73C\uC73C \uC838\uBC84\uB9AC\uB2E4\uB2C8..!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387886
    m_Localized: "\uB2E4\uC74C\uC5D0\uB294 \uBD10\uC8FC\uC9C0 \uC54A\uC744 \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387887
    m_Localized: "\uB124\uAC00 \uB2E4\uCE58\uC9C0 \uC54A\uC544\uC11C \uB2E4\uD589\uC774\uC57C.."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387888
    m_Localized: "...\uC774\uAC74 \uC880 \uC544\uD50C\uAC70\uC57C"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387889
    m_Localized: "\uC624\uB798\uC804. \uC778\uAC04\uACFC \uC774\uC885\uC871\uC758
      \uAC08\uB4F1\uC774 \uC810\uCC28 \uACA9\uD574\uC838 \uB9C8\uCE68\uB0B4 \uCD5C\uACE0\uC870\uC5D0
      \uB2EC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387890
    m_Localized: "\uB2F9\uC7A5\uC774\uB77C\uB3C4 \uD070 \uC2F8\uC6C0\uC774 \uBC8C\uC5B4\uC9C8
      \uB4EF\uD588\uB358 \uADF8\uB54C. \uD640\uC5F0\uD788 \uB098\uD0C0\uB09C '\uB9C8\uC655'\uC774
      \uC774\uC885\uC871\uC744 \uADDC\uD569\uD574 \uAC70\uB300\uD55C \uC138\uB825\uC744
      \uC138\uC6B0\uB2C8, \uC0AC\uB78C\uB4E4\uC740 \uC774\uB97C \uB9C8\uC655\uAD70\uC774\uB77C
      \uBD88\uB800\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387891
    m_Localized: "\uBD88\uC548\uC5D0 \uBE60\uC9C4 \uC778\uAC04\uB4E4\uC740 \uB2F9\uC2E0\uC758
      \uC18C\uAFC9\uCE5C\uAD6C\uB97C \uC6A9\uC0AC\uB85C \uBC1C\uD0C1\uD588\uB2E4.
      \uD558\uC9C0\uB9CC \uB9C8\uC655\uAD70\uC758 \uC704\uD611\uC744 \uC870\uAE30\uC5D0
      \uB9C9\uACE0\uC790 \uD640\uB85C \uB9C8\uC655\uC131\uC73C\uB85C \uD5A5\uD588\uB358
      \uCE5C\uAD6C\uB294, \uADF8\uACF3\uC5D0\uC11C \uAC10\uAC10\uBB34\uC18C\uC2DD\uC73C\uB85C
      \uC2E4\uC885\uB418\uACE0 \uB9D0\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387892
    m_Localized: "\uADF8\uB9AC\uACE0 \uD604\uC7AC. \uC0AC\uB77C\uC9C4 \uC18C\uAFC9\uCE5C\uAD6C\uC758
      \uD754\uC801\uC744 \uCAD3\uC544, \uB2F9\uC2E0 \uB610\uD55C \uB9C8\uC655\uC131\uC758
      \uC785\uAD6C\uC5D0 \uB3C4\uB2EC\uD558\uBA70 \uC774\uC57C\uAE30\uB294 \uC2DC\uC791\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387893
    m_Localized: "\uB9C8\uC655\uC740 \uC4F0\uB7EC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387894
    m_Localized: "\uC655\uAD6D\uC744 \uC704\uD611\uD558\uB358 \uC774\uC885\uC871\uC740
      \uB9C8\uC655\uC758 \uBD80\uC7AC\uB85C \uBFD4\uBFD4\uC774 \uD769\uC5B4\uC84C\uB2E4.
      \uD769\uC5B4\uC9C4 \uC774\uC885\uC871\uC774 \uAC01\uC9C0\uC5D0\uC11C \uBB38\uC81C\uB97C
      \uC77C\uC73C\uD0A8\uB2E4\uB294 \uC18C\uC2DD\uB3C4 \uB4E4\uB824\uC654\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387895
    m_Localized: "\uB2F9\uC2E0\uC758 \uCE5C\uAD6C\uAC00 \uC5B4\uC9F8\uC11C \uB9C8\uC655\uC744
      \uC790\uCC98\uD588\uB294\uC9C0 \uC544\uC9C1 \uBAA8\uB974\uC9C0\uB9CC, \uC5B4\uCA0C\uAC70\uB098
      \uC655\uAD6D\uC740 \uADC0\uD658\uD55C \uB2F9\uC2E0\uC744 \uD658\uC601\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387896
    m_Localized: "\uD558\uC9C0\uB9CC... \uC815\uB9D0 \uC774\uAC83\uC73C\uB85C \uB41C
      \uAC78\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387897
    m_Localized: "\uB9C8\uC655\uC758 \uC54C\uD604\uC2E4 \uC785\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 192956148387898
    m_Localized: "\uB9C8\uC655\uC758 \uC54C\uD604\uC2E4"
    m_Metadata:
      m_Items: []
