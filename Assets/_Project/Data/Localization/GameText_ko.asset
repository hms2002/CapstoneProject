      m_Items: []
  - m_Id: 61692179288064
    m_Localized: "\uAD73\uAC8C \uC7A0\uACA8\uC788\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288065
    m_Localized: "\uC791\uB3D9\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288066
    m_Localized: "\uC774\uB3D9\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288067
    m_Localized: "\uB3C4\uAC10 \uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288068
    m_Localized: "\uC6B4\uB3D9\uAE30\uAD6C \uC138 \uAC1C \uC911 \uD558\uB098\uB97C
      \uC0AC\uC6A9\uD574! \uADFC\uB825\uC740 \uACF5\uACA9\uB825, \uBC14\uD034\uB294
      \uC774\uB3D9\uC18D\uB3C4, \uD1B5\uB098\uBB34\uB294 \uACBD\uD5D8\uCE58\uB97C
      \uC62C\uB824\uC918!"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288069
    m_Localized: "\uC606\uC758 \uC0C1\uC790 \uB354\uBBF8\uC5D0\uC11C \uC18C\uD3EC\uB97C
      \uAC00\uC838\uAC00 \uC8FC\uC138\uC694. \uC18C\uD3EC\uB294 \uC720\uBB3C \uC2AC\uB86F\uC744
      \uCC28\uC9C0\uD558\uBA70 \uBC84\uB9B4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288070
    m_Localized: "\uC774\uBBF8 \uC6B8\uB9B0 \uACBD\uBCF4 \uC885\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288071
    m_Localized: "\uACBD\uBCF4 \uC885\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288072
    m_Localized: "\uACBD\uBCF4 \uC885\uC774 \uC6B8\uB838\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288073
    m_Localized: "\uACBD\uBCF4 \uC885 \uC804\uD22C \uC644\uB8CC!"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288074
    m_Localized: "\uC138 \uBCF4\uC2A4\uB97C \uBAA8\uB450 \uCC98\uCE58\uD574\uC57C
      \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288075
    m_Localized: "\uC81C\uBB3C\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288076
    m_Localized: "\uBB34\uAE30\uAC00 \uC5C6\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288077
    m_Localized: "\uBB34\uAE30\uAC00 \uC5C6\uC73C\uBA74 \uCD9C\uBC1C\uD560 \uC218
      \uC5C6\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288078
    m_Localized: "\uBB34\uAE30\uB97C \uBA3C\uC800 \uCC59\uACA8\uC57C\uACA0\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288079
    m_Localized: "{0}\uC77C"
    m_Metadata:
      m_Items: []
  - m_Id: 61692179288080
    m_Localized: "\uC2AC\uB86F {0}\uC758 \uD504\uB85C\uD544 \uB370\uC774\uD130\uB97C
      \uC0AD\uC81C\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\n\uC774 \uC791\uC5C5\uC740
      \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 64258292224000
    m_Localized: "\uBB34\uAE30\uC640 \uC720\uBB3C \uD574\uAE08"
    m_Metadata:
      m_Items: []
  - m_Id: 64258392887296
    m_Localized: "\uC0C1\uC810 \uD310\uB9E4 \uAC00\uACA9 20% \uD560\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 64258392887297
    m_Localized: "TeleportNpc \uC774\uC6A9 \uAC00\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 64258392887298
    m_Localized: "\uC0C1\uC790\uC758 \uB0B4\uC6A9\uBB3C\uC744 \uB9AC\uB864\uD560
      \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 64258392887299
    m_Localized: "10% \uD655\uB960\uB85C \uC720\uBB3C\uC758 \uB808\uBCA8\uC774 +1\uB41C
      \uC0C1\uD0DC\uB85C \uB4F1\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 64258392887300
    m_Localized: "\uC0C1\uC790 \uB0B4\uC6A9\uBB3C\uC5D0 \uC720\uBB3C 1\uAC1C \uCD94\uAC00
      \uB4F1\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 64258392887301
    m_Localized: "\uBE44\uC804\uD22C \uC774\uB3D9\uC18D\uB3C4 +50%"
    m_Metadata:
      m_Items: []
  - m_Id: 64258392887302
    m_Localized: "\uC7A1\uB3D9\uC0AC\uB2C8\uC5D0\uC11C \uB098\uC624\uB294 \uC720\uBB3C
      \uC218  \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 64258392887303
    m_Localized: "\uCD5C\uB300 \uCCB4\uB825 +1"
    m_Metadata:
      m_Items: []
  - m_Id: 64258392887304
    m_Localized: "\uCD5C\uB300 \uCCB4\uB825 +1"
    m_Metadata:
      m_Items: []
  - m_Id: 64258397081600
    m_Localized: "\uC720\uBB3C \uC2AC\uB86F 4\uCE78 \uD655\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 64258397081601
    m_Localized: "\uC720\uBB3C \uC2AC\uB86F 4\uCE78 \uD655\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 64258397081602
    m_Localized: "\uC720\uBB3C \uC2AC\uB86F 4\uCE78 \uD655\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 64258397081603
    m_Localized: "\uC2DC\uC791 \uC2DC \uD3EC\uC158 1\uAC1C \uC9C0\uAE09 "
    m_Metadata:
      m_Items: []
  - m_Id: 64258397081604
    m_Localized: "\uC77C\uD68C\uC131 \uCD94\uAC00 \uCCB4\uB825 \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 64258397081605
    m_Localized: "\uC0C1\uC810 \uD65C\uC131\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 64258397081606
    m_Localized: "\uC0C1\uC810 \uBB3C\uD488 20% \uD560\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 64258397081607
    m_Localized: "\uC0C1\uC810 \uC0C8\uB85C\uACE0\uCE68 1\uD68C \uAC00\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 64258397081608
    m_Localized: "\uC124\uBA85 \uC900\uBE44 \uC911"
    m_Metadata:
      m_Items: []
  - m_Id: 64258397081609
    m_Localized: "\uD6A8\uACFC \uC815\uBCF4 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 64258397081610
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC \uACF5\uAC04\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4.
      \uC778\uBCA4\uD1A0\uB9AC \uC544\uC774\uD15C\uC744 \uBC84\uB9AC\uB294 \uAD6C\uC5ED\uC73C\uB85C
      \uB4DC\uB798\uADF8\uD574 \uBC84\uB9B0 \uD6C4 \uB2E4\uC2DC \uD655\uC815\uD574
      \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 102995688591360
    m_Localized: "\uB1CC\uCC3D \uD729\uC4F8\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 102995743117312
    m_Localized: "\uB1CC\uCC3D \uB3CC\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 102995743117313
    m_Localized: "\u25CF {em:\uB099\uB8B0 \uD45C\uC2DD\uC774 \uC5C6\uC744 \uB54C}
      \uC81C\uC790\uB9AC\uC5D0\uC11C \uC804\uBC29\uC744 \uD729\uC4F8\uAE30\n\u25CF
      \uBCF4\uC720\uD55C {em:\uD68C\uC218 \uCC3D}\uC744 \uC870\uC900 \uBC29\uD5A5
      \uC55E\uCABD\uC5D0\uC11C \uBD80\uCC44\uAF34\uB85C \uC21C\uCC28 \uBC1C\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 102995743117314
    m_Localized: "\u25CF \uCEE4\uC11C \uC8FC\uBCC0\uC758 [[\uB099\uB8B0 \uD45C\uC2DD]]\uC73C\uB85C
      \uC989\uC2DC \uB3CC\uC9C4\n\u25CF \uC774\uB3D9 \uACBD\uB85C\uC640 \uB3C4\uCC29
      \uC9C0\uC810\uC744 \uACF5\uACA9\n\u25CF \uD45C\uC2DD \uC18C\uBAA8 \uC2DC {pos:\uB1CC\uCC3D
      \uB3CC\uACA9 \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04 \uCD08\uAE30\uD654}\n\u25CF
      {em:\uD68C\uC218 \uCC3D} {val:1\uAC1C} \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
