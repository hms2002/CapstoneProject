    m_Metadata:
      m_Items: []
  - m_Id: 46294692171818
    m_Localized: "\uAD6C\uB9E4\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 46294692171819
    m_Localized: "\u25CF [[{0}]] {{pos:[+{1}]}} \uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 46294692171820
    m_Localized: "{0}\n\uC785\uB825: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294692171821
    m_Localized: "\n\uCFE8\uB2E4\uC6B4: {0:0.##}s"
    m_Metadata:
      m_Items: []
  - m_Id: 46294692171822
    m_Localized: "<b>\uB2A5\uB825\uCE58</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 46294692171823
    m_Localized: "\uC785\uB825: <color=#A7E1FF>{0}</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 46294692171824
    m_Localized: "\uCFE8\uB2E4\uC6B4: <color=#FFD54F>{0:0.##}s</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 46294692171825
    m_Localized: "\uD0DC\uADF8: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294700560384
    m_Localized: "<b>\uC0C1\uC138</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 46294700560385
    m_Localized: "<color=#FFFFFF>\uC77C\uBC18</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 46294700560386
    m_Localized: "<color=#409CFF>\uD76C\uADC0</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754688
    m_Localized: "<color=#FFFF00>\uC804\uC124</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754689
    m_Localized: "\u25CF [[\uD654\uC0C1]] \uC18C\uBAA8 \uC8FC\uAE30 {{pos:{0:0}%
      \uAC10\uC18C}} (\uC8FC\uAE30 {{val:{1:0.##}\uCD08}})"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754690
    m_Localized: "\u25CF [[\uD654\uC0C1 \uD53C\uD574]] \uACC4\uC218 {{pos:+{0:0}%p}}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754691
    m_Localized: "\u25CF [[\uD654\uC0C1]] \uBD80\uC5EC\uB7C9 {{pos:+{0}}}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754692
    m_Localized: "\u25CF [[\uD654\uC0C1]]\uC774 \uC5C6\uB294 \uC801\uC5D0\uAC8C \uCC98\uC74C
      \uBD80\uC5EC\uD558\uB294 [[\uD654\uC0C1]] {{pos:+{0}\uC911\uCCA9}}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754693
    m_Localized: "\u25CF [[\uD654\uC0C1 \uD53C\uD574]]\uC5D0 \uCE58\uBA85\uD0C0 \uD655\uB960\uACFC
      \uCE58\uBA85\uD0C0 \uD53C\uD574 \uC801\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754694
    m_Localized: "\u25CF \uB300\uC0C1\uC758 [[\uD654\uC0C1]] {{val:{0}\uC911\uCCA9}}\uB9C8\uB2E4
      [[\uD654\uC0C1 \uD53C\uD574]] {{pos:+{1:0}%}}\n\u25CF \uCD5C\uB300 {{val:{2:0}%}}\uAE4C\uC9C0
      \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754695
    m_Localized: "\u25CF \uB300\uC0C1\uC5D0\uAC8C [[\uD654\uC0C1]]\uC774 \uC5C6\uC73C\uBA74
      [[\uD654\uC0C1]] {{val:{0}\uC911\uCCA9}} \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754696
    m_Localized: "\u25CF {{val:{0:0.##}\uCD08}}\uB9C8\uB2E4 {{em:\uD0DC\uC591\uC758
      \uD30C\uD3B8}} \uC0DD\uC131\n\u25CF \uCD5C\uB300 {{val:{1}\uAC1C}} \uC720\uC9C0\n"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754697
    m_Localized: "\u25CF \uC801\uACFC \uC811\uCD09 \uC2DC [[\uD654\uC5FC \uD53C\uD574]]
      {{val:100%}} \uBC0F [[\uD654\uC0C1]] {{val:{0}\uC911\uCCA9}} \uBD80\uC5EC \uD6C4
      \uC18C\uBA78"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754698
    m_Localized: "\uB099\uB8B0 \uD45C\uC2DD\uC774 \uC5C6\uC73C\uBA74 \uC804\uBC29\uC744
      \uD729\uC4F8\uACE0, \uBAA8\uC544 \uB454 {em:\uD68C\uC218 \uCC3D}\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754699
    m_Localized: "\uCEE4\uC11C \uC8FC\uBCC0\uC758 [[\uB099\uB8B0 \uD45C\uC2DD]]\uC73C\uB85C
      \uB3CC\uC9C4\uD574 \uACBD\uB85C\uC758 \uC801\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4.
      \uD45C\uC2DD\uC744 \uC18C\uBAA8\uD558\uBA74 \uB2E4\uC2DC \uC0AC\uC6A9\uD560
      \uC218 \uC788\uACE0 {em:\uD68C\uC218 \uCC3D}\uC744 \uC5BB\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754700
    m_Localized: "\uD22C\uC0AC\uCCB4 \uC2A4\uD0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754701
    m_Localized: "\uD53C\uD574(\uACF5\uC2DD): {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754702
    m_Localized: "\uD53C\uD574: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754703
    m_Localized: "\uC774\uB3D9 \uC18D\uB3C4 +{0:0.#}%, \uACF5\uACA9 \uC18D\uB3C4
      +{1:0.#}%\n\uB0A8\uC740 \uC2DC\uAC04: {2:0.0}\uCD08"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754704
    m_Localized: "\uC800\uC8FC \uD574\uC81C\n\uCD5C\uB300 \uCCB4\uB825 +{0:0.#}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754705
    m_Localized: "\uCD5C\uB300 \uCCB4\uB825 -{0:0.#}\n\uD53C\uD574\uB97C \uBC1B\uC740
      \uD69F\uC218: {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754706
    m_Localized: "\uC800\uC8FC \uD574\uC81C\n\uD654\uC0C1 \uD53C\uD574 +{0:0.#}%\n\uD654\uC0C1
      \uBD80\uC5EC\uB7C9 +{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754707
    m_Localized: "\uC9C1\uC811 \uD53C\uD574 -{0:0.#}%\n\uD654\uC0C1 \uD53C\uD574\uB85C
      \uCC98\uCE58: {1}/{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754708
    m_Localized: "\uB9C8\uC655"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754709
    m_Localized: "\uB9C8\uC655\uC758 \uC54C\uD604\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754710
    m_Localized: "\uB300\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754711
    m_Localized: "\uB1CC\uCC3D \uB3CC\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754712
    m_Localized: "\uB9C8\uC655"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754713
    m_Localized: "\uD3EC\uC158\uC758 \uD68C\uBCF5\uB7C9\uC774 1\uC5D0\uC11C 2\uB85C
      \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754714
    m_Localized: "\uD3EC\uC158\uC758 \uD68C\uBCF5\uB7C9\uC774 1\uC5D0\uC11C 2\uB85C
      \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754715
    m_Localized: "\uBC84\uD53C"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754716
    m_Localized: "\uC2A4\uD53C\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754717
    m_Localized: "\uC0AC\uC0E4"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754718
    m_Localized: "\uBCA8\uCE74"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754719
    m_Localized: "\uD30C\uC140"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754720
    m_Localized: "\uC11C\uAE30\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754721
    m_Localized: "\uBA5C\uD0C0"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754722
    m_Localized: "\uC544, \uADF8\uB798? \uADF8\uB7FC \uADF8\uB0E5 \uAC08\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754723
    m_Localized: "\uADF8 \uACF5\uC0AC \uB300\uAE08\uC744 \uB0B4\uAC00 \uB0B4\uC904
      \uC218\n\uC788\uB294\uB370. \uB9C8\uC815\uC11D -50"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754724
    m_Localized: "\uADF8\uB798. \uBD80\uD0C1\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754725
    m_Localized: "\uC544\uB2C8. \uAD1C\uCC2E\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754726
    m_Localized: "\uACBD\uBCF4 \uC885 \uC6B8\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754727
    m_Localized: "\uACBD\uBCF4 \uC885"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754728
    m_Localized: "\uACBD\uBCF4 \uC885 \uC6B8\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754729
    m_Localized: "\uACBD\uBCF4 \uC885"
    m_Metadata:
      m_Items: []
  - m_Id: 46294704754730
    m_Localized: "\uACBD\uBCF4 \uC885"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708948992
    m_Localized: "\uBC84\uD53C\uC758 \uD5EC\uC2A4\uD0C0\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708948993
    m_Localized: "\uBC84\uD53C\uC758 \uD5EC\uC2A4\uD0C0\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708948994
    m_Localized: "\uBC84\uD53C\uC758 \uD5EC\uC2A4\uD0C0\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708948995
    m_Localized: "\uC18C\uD3EC \uBC30\uB2EC \uB300\uD589"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708948996
    m_Localized: "\uC18C\uD3EC \uBC30\uC1A1 \uC9C0\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708948997
    m_Localized: "\uC18C\uD3EC \uBC30\uB2EC \uB300\uD589"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708948998
    m_Localized: "\uC18C\uD3EC \uBC30\uC1A1 \uC9C0\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708948999
    m_Localized: "\uC18C\uD3EC \uBC30\uB2EC \uB300\uD589"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949000
    m_Localized: "\uC18C\uD3EC \uBC30\uC1A1 \uC9C0\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949001
    m_Localized: "\uD68C\uBCF5 \uBB3C\uC57D"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949002
    m_Localized: "\uC18C\uD3EC"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949003
    m_Localized: "\uD30C\uC140\uC774 \uBC30\uB2EC\uD574\uC57C \uD588\uC744 \uC18C\uD3EC.
      \uBC84\uB9AC\uB294\uAC74 \uC6A9\uC0AC\uB2F5\uC9C0 \uC54A\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949004
    m_Localized: "\uD798 \uBD80\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949005
    m_Localized: "\uACF5\uACA9\uB825\uC774 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949006
    m_Localized: "\uADE0\uD615\uCD94"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949007
    m_Localized: "\uAE30\uBCF8\uACF5\uACA9 \uD53C\uD574\uC640 \uC2A4\uD0AC \uD53C\uD574\uAC00
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949008
    m_Localized: "\uAD11\uC804\uC0AC\uC758 \uB048"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949009
    m_Localized: "\uCD5C\uB300 \uCCB4\uB825\uC774 \uAC10\uC18C\uD558\uC9C0\uB9CC
      \uACF5\uACA9\uC18D\uB3C4\uAC00 \uD06C\uAC8C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949010
    m_Localized: "\uAC80\uC740 \uD5A5\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949011
    m_Localized: "\uC2A4\uD0AC \uD53C\uD574\uAC00 \uD06C\uAC8C \uC99D\uAC00\uD558\uC9C0\uB9CC
      \uAE30\uBCF8\uACF5\uACA9 \uD53C\uD574\uAC00 \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949012
    m_Localized: "\uBB34\uB518 \uBC29\uD328"
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949013
    m_Localized: "\uACF5\uACA9\uC18D\uB3C4\uAC00 \uAC10\uC18C\uD558\uC9C0\uB9CC \uCD5C\uB300
      \uCCB4\uB825\uC774 \uD06C\uAC8C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294708949014
    m_Localized: "\uAE68\uC9C4 \uC2DC\uACC4"
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143296
    m_Localized: "\uACF5\uACA9\uC18D\uB3C4\uAC00 \uC99D\uAC00\uD558\uC9C0\uB9CC \uC2A4\uD0AC
      \uD53C\uD574\uAC00 \uAC10\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143297
    m_Localized: "\uBD80\uC11C\uC9C4 \uC655\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143298
    m_Localized: "\uCD5C\uB300 \uCCB4\uB825\uC774 \uAC10\uC18C\uD558\uC9C0\uB9CC
      \uCD5C\uC885 \uD53C\uD574\uAC00 \uD06C\uAC8C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143299
    m_Localized: "\uCCAD\uB3D9 \uC8FC\uC0AC\uC704"
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143300
    m_Localized: "\uCE58\uBA85\uD0C0 \uD655\uB960\uACFC \uD68C\uD53C\uC728\uC774
      \uC870\uAE08 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143301
    m_Localized: "\uBD88\uD0C0\uB294 \uAE43\uD138"
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143302
    m_Localized: "\uBAA8\uB4E0 \uD654\uC0C1 \uBD80\uC5EC\uB7C9\uC774 \uB298\uC5B4\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143303
    m_Localized: "\uC5EC\uC720\uB85C\uC6B4 \uC2EC\uC7A5"
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143304
    m_Localized: "\uCCB4\uB825\uC774 \uB192\uC744 \uB54C \uC774\uB3D9\uC18D\uB3C4\uAC00
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143305
    m_Localized: "\uC5F0\uC1C4\uC758 \uBD80\uC801"
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143306
    m_Localized: "\uCE58\uBA85\uD0C0\uB97C \uB0B4\uBA74 \uC774\uB3D9\uC18D\uB3C4\uAC00
      \uB204\uC801 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143307
    m_Localized: "\uC804\uD22C \uC7A5\uAC11"
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143308
    m_Localized: "\uACF5\uACA9\uC18D\uB3C4\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143309
    m_Localized: "\uBC18\uACA9\uC758 \uBC15\uCC28"
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143310
    m_Localized: "\uD53C\uD574\uB97C \uBC1B\uC73C\uBA74 \uC7A0\uC2DC \uC774\uB3D9\uC18D\uB3C4\uAC00
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143311
    m_Localized: "\uD64D\uB828\uC758 \uC655\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143312
    m_Localized: "\uC801\uC758 \uD654\uC0C1 \uC911\uCCA9\uC5D0 \uBE44\uB840\uD574
      \uD654\uC0C1 \uD53C\uD574\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143313
    m_Localized: "\uC804\uB958 \uC870\uAC01"
    m_Metadata:
      m_Items: []
  - m_Id: 46294713143314
    m_Localized: "\uC804\uAE30 \uC18D\uC131 \uBCF4\uB108\uC2A4\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294717337600
    m_Localized: "\uB3C5\uD55C \uC220\uAE30\uC6B4"
    m_Metadata:
      m_Items: []
  - m_Id: 46294717337601
