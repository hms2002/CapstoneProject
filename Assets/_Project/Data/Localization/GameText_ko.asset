  m_TableData:
  - m_Id: 8714620928
    m_Localized: "<color=#96DCFA>\uC7AC\uC7A5\uC804\uC740 \uC5C6\uB2E4. \uC5EC\uC12F
      \uBC1C\uC774 \uB05D\uB098\uBA74, \uC774\uC81C \uB358\uC9C8 \uC77C\uB9CC \uB0A8\uC740
      \uAE30\uBB18\uD55C \uC1F3\uB369\uC774.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 8903364608
    m_Localized: "\uD604\uC7AC \uCCB4\uB825\uC774 {threshold} \uC774\uD558\uC77C
      \uACBD\uC6B0 \uBAA8\uB4E0 \uACF5\uACA9\uC774 \uBC18\uB4DC\uC2DC \uCE58\uBA85\uD0C0\uB85C
      \uC801\uC911."
    m_Metadata:
      m_Items: []
  - m_Id: 8911753216
    m_Localized: "\uC5B4\uC11C \uC640, \uC6A9\uC0AC\uB2D8! \uC624\uB298\uB3C4 \uBC18\uC9DD\uBC18\uC9DD\uD55C
      \uB9C8\uC815\uC11D\uC740 \uB450\uB451\uD558\uAC8C \uCC59\uACA8 \uC654\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 8911753217
    m_Localized: "\uC624\uB298\uC740 \uBB58 \uD30C\uB294\uB370?"
    m_Metadata:
      m_Items: []
  - m_Id: 8915947520
    m_Localized: "\uADF8\uB0E5 \uAD6C\uACBD\uB9CC \uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 8915947521
    m_Localized: "\uCC3D\uBAA8\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 8915947522
    m_Localized: "\uD14C\uB450\uB9AC \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 8915947523
    m_Localized: "\uC804\uCCB4\uD654\uBA74"
    m_Metadata:
      m_Items: []
  - m_Id: 8915947524
    m_Localized: "\uCF1C\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 8915947525
    m_Localized: "\uB044\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 46294406959104
    m_Localized: "\uBAAC\uC2A4\uD130\uB97C \uCAD3\uC544\uAC00\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811648
    m_Localized: "\uB300\uC2DC\uB85C \uACF5\uACA9\uC744 \uD53C\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811649
    m_Localized: "\uC55E\uC73C\uB85C \uC774\uB3D9\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811650
    m_Localized: "\uC88C\uD074\uB9AD"
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811651
    m_Localized: "\uC6B0\uD074\uB9AD"
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811652
    m_Localized: "\uC0C1\uC790\uB97C \uC5F4\uACE0 \uC544\uC774\uD15C \uC120\uD0DD
      \uD6C4 \uD68D\uB4DD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811653
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC\uB97C \uC5F4\uC5B4 \uD68D\uB4DD\uD55C
      \uC544\uC774\uD15C \uD655\uC778\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811654
    m_Localized: "1\uBC88 \uC18C\uBAA8\uD488 \uC2AC\uB86F\uC758 \uD3EC\uC158 \uC0AC\uC6A9\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811655
    m_Localized: "\uC704\uCABD \uD3EC\uD0C8\uB85C \uC774\uB3D9\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811656
    m_Localized: "\uB9C8\uC655"
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811657
    m_Localized: "\uCC98\uCE58\uC790 \uB9C8\uC655"
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811658
    m_Localized: "\uB9C8\uC655\uC758 \uC54C\uD604\uC2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 46294662811659
    m_Localized: "\uC704\uB85C \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005952
    m_Localized: "\uC544\uB798\uB85C \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005953
    m_Localized: "\uC67C\uCABD\uC73C\uB85C \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005954
    m_Localized: "\uC624\uB978\uCABD\uC73C\uB85C \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005955
    m_Localized: "\uACF5\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005956
    m_Localized: "\uC0C1\uD638\uC791\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005957
    m_Localized: "\uB300\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005958
    m_Localized: "\uC2A4\uD0AC 1"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005959
    m_Localized: "\uC2A4\uD0AC 2"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005960
    m_Localized: "\uBB34\uAE30 \uAD50\uCCB4"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005961
    m_Localized: "\uC18C\uBAA8\uD488 1"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005962
    m_Localized: "\uC18C\uBAA8\uD488 2"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005963
    m_Localized: "\uC18C\uBAA8\uD488 3"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005964
    m_Localized: "\uC18C\uBAA8\uD488 4"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005965
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005966
    m_Localized: "\uB300\uD654 \uB118\uAE30\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005967
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC \uC544\uC774\uD15C \uBC84\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005968
    m_Localized: "\uB808\uBCA8 \uBCF4\uC0C1 \uC5F4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005969
    m_Localized: "\uBBF8\uB2C8\uB9F5 \uD655\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005970
    m_Localized: "\uBBF8\uB2C8\uB9F5 \uCD95\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005971
    m_Localized: "\uB300\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005972
    m_Localized: "\uC544\uC774\uD15C\uC744 \uD68D\uB4DD\uD558\uAC70\uB098 \uC120\uD0DD\uC744
      \uD574\uC81C\uD574 \uC8FC\uC2ED\uC2DC\uC624."
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005973
    m_Localized: "\uC120\uD0DD {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005974
    m_Localized: "\uC544\uC774\uD15C\uC744 \uD68D\uB4DD\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uC778\uBCA4\uD1A0\uB9AC\uC640 \uC720\uBB3C \uC0C1\uD0DC\uB97C \uD655\uC778\uD574
      \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005975
    m_Localized: "\uC5C5\uADF8\uB808\uC774\uB4DC \uC644\uB8CC!"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005976
    m_Localized: "\uD638\uAC10\uB3C4 \uBCF4\uC0C1!"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005977
    m_Localized: "- \uC544\uC774\uD15C\uC774 \uD574\uAE08\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005978
    m_Localized: "\uC720\uBB3C \uC778\uBCA4\uD1A0\uB9AC\uAC00 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005979
    m_Localized: "\uC774\uBBF8 \uCD5C\uB300 \uB808\uBCA8\uC778 \uC720\uBB3C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005980
    m_Localized: "\uBB34\uAE30 \uC778\uBCA4\uD1A0\uB9AC\uAC00 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005981
    m_Localized: "\uC77C\uD68C\uC6A9 \uC544\uC774\uD15C \uC778\uBCA4\uD1A0\uB9AC\uAC00
      \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005982
    m_Localized: "\uC5EC\uAE30\uC5D0\uB294 \uBC84\uB9B4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005983
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uBB34\uAE30\uB294 \uBC84\uB9AC\uAC70\uB098
      \uC62E\uAE38 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005984
    m_Localized: "\uD604\uC7AC \uCCB4\uB825\uC774 \uBD80\uC871\uD574 \uD574\uC81C\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005985
    m_Localized: "\uC774\uBBF8 \uAD6C\uB9E4\uB41C \uC5C5\uADF8\uB808\uC774\uB4DC
      \uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005986
    m_Localized: "\uC774\uBC88 \uD0D0\uD5D8\uC5D0\uC11C \uC774\uBBF8 \uCC98\uCE58\uD55C
      \uBCF4\uC2A4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005987
    m_Localized: "\uBB34\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005988
    m_Localized: "\uC720\uBB3C"
    m_Metadata:
      m_Items: []
  - m_Id: 46294667005989
