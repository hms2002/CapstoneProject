    m_Localized: "\uD53C\uD574\uB97C \uBC1B\uC73C\uBA74 \uC7A0\uC2DC \uD68C\uD53C\uC728\uC774
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294721531909
    m_Localized: "\uB2EC\uB9AC\uB294 \uC7A5\uBD80"
