      2 \uD68C\uBCF5</color>\n\uD53C\uD574\uB97C \uBC1B\uC9C0 \uC54A\uC558\uB2E4\uBA74\n<color=#197A67>\uCD5C\uB300
      \uCCB4\uB825 +1</color> (\uCD5C\uB300 3\uD68C)"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883144
    m_Localized: "<color=#A8324A>\uC9C1\uC811 \uD53C\uD574 -20%</color>\n<color=#197A67>\uC804\uAE30
      \uCD95\uC801\uB7C9 +25%</color>\n<color=#197A67>\uC804\uAE30 \uBC1C\uD604 \uD53C\uD574
      +2</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883145
    m_Localized: "5\uCD08 \uC548\uC5D0 \uC801 5\uBA85\uC744 \uCC98\uCE58\uD558\uBA74\n5\uCD08
      \uB3D9\uC548 <color=#197A67>\uACF5\uACA9 \uC18D\uB3C4 +20%</color>\n\uD6A8\uACFC
      \uC911 \uC801\uC744 \uCC98\uCE58 \uC2DC \uC9C0\uC18D \uC2DC\uAC04 \uCD08\uAE30\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883146
    m_Localized: "<color=#8A5A10>\uC801 20\uBA85 \uCC98\uCE58\uD560 \uB54C\uB9C8\uB2E4</color>\n<color=#197A67>\uCCB4\uB825
      1 \uD68C\uBCF5</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883147
    m_Localized: "<color=#8A5A10>\uC801 \uCC98\uCE58 \uC2DC</color>\n\uB0A8\uC740
      \uBB34\uAE30 \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\n<color=#197A67>5%
      \uAC10\uC18C</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883148
    m_Localized: "<color=#8A5A10>\uC120\uD0DD \uC2DC \uD604\uC7AC \uB808\uBCA8 3\uB9C8\uB2E4</color>\n<color=#197A67>\uCD5C\uB300
      \uD558\uD2B8 +1</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883149
    m_Localized: "<color=#8A5A10>\uB0A8\uC740 \uC2DC\uAC04 6\uBD84 \uC774\uD558\uC77C
      \uB54C</color>\n<color=#197A67>\uC774\uB3D9 \uC18D\uB3C4 +40%</color>\n<color=#197A67>\uACF5\uACA9
      \uC18D\uB3C4 +25%</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883150
    m_Localized: "<color=#A8324A>2\uBC88 \uBB34\uAE30 \uC2AC\uB86F \uBD09\uC778</color>\n<color=#197A67>\uACF5\uACA9\uB825
      +25%</color>\n1\uBC88 \uBB34\uAE30 \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\n<color=#197A67>25%
      \uAC10\uC18C</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883151
    m_Localized: "<color=#A8324A>\uC9C1\uC811 \uD53C\uD574 -20%</color>\n<color=#197A67>\uD654\uC0C1
      \uBD80\uC5EC\uB7C9 +2</color>\n<color=#197A67>\uD654\uC0C1 \uD53C\uD574 +30%</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883152
    m_Localized: "\uD3EC\uC158 \uC0AC\uC6A9 \uD6C4 15\uCD08 \uB3D9\uC548 <color=#2474D2>\uC57C\uD638!</color>
      \uC0C1\uD0DC \uB3CC\uC785.\n<color=#2474D2>\uC57C\uD638!</color>: \uC774\uB3D9
      \uC18D\uB3C4 +30%, \uACF5\uACA9 \uC18D\uB3C4 +15%"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883153
    m_Localized: "\uD3EC\uC158\uC744 \uC0AC\uC6A9\uD560 \uB54C\uB9C8\uB2E4 \uACF5\uACA9
      \uC18D\uB3C4\uAC00 2% \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883154
    m_Localized: "\uAC15\uD654 \uAC00\uB2A5\uD55C \uC720\uBB3C \uC911\n\uBB34\uC791\uC704
      <color=#8A5A10>\uCD5C\uB300 3\uAC1C</color>\n<color=#197A67>\uAC01\uAC01 \uC720\uBB3C
      \uB808\uBCA8 +1</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883155
    m_Localized: "<color=#197A67>\uC77C\uD68C\uC131 \uCCB4\uB825 3\uAC1C \uD68D\uB4DD</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883156
    m_Localized: "\uD654\uC0C1 \uD53C\uD574\uB85C \uC801\uC744 \uCC98\uCE58\uD558\uBA74\n\uC2DC\uC57C
      \uB0B4 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C\n<color=#197A67>\uD654\uC0C1
      3 \uBD80\uC5EC</color>\n\uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04 0.5\uCD08"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883157
    m_Localized: "<color=#A8324A>\uCD5C\uB300 \uCCB4\uB825 -2</color>\n\uD53C\uD574\uB97C
      4\uD68C \uBC1B\uC73C\uBA74 \uC800\uC8FC\uAC00 \uD480\uB9AC\uACE0\n\uAE30\uC874
      \uCD5C\uB300 \uCCB4\uB825\uBCF4\uB2E4\n<color=#197A67>\uCD5C\uB300 \uCCB4\uB825
      +2</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883158
    m_Localized: "<color=#A8324A>\uC9C1\uC811 \uD53C\uD574 -15%</color>\n\uD654\uC0C1
      \uD53C\uD574\uB85C \uC801 10\uBA85\uC744 \uCC98\uCE58\uD558\uBA74 \uC800\uC8FC\uAC00
      \uD480\uB9AC\uACE0\n<color=#197A67>\uD654\uC0C1 \uD53C\uD574 +25%</color>\n<color=#197A67>\uD654\uC0C1
      \uBD80\uC5EC\uB7C9 +1</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883159
    m_Localized: "\u25CF {em:\uAC1C\uD654 \uC0C1\uD0DC} \uC9C4\uC785\n\u25CF {val:3\uCD08}
      \uB3D9\uC548 {pos:\uC77C\uBC18 \uD53C\uD574 \uC99D\uAC00} {val:+25}, {pos:\uACF5\uACA9\uC18D\uB3C4
      \uC99D\uAC00} {val:+2.5}, {pos:\uC774\uB3D9\uC18D\uB3C4 \uC99D\uAC00} {val:+60%}\n\u25CF
      \uC9C0\uC18D \uC911 \uAE30\uBCF8 \uACF5\uACA9\uC774 {em:\uB113\uC740 \uB9CC\uAC1C
      \uCC38\uACA9}\uC73C\uB85C \uBCC0\uD568\n\u25CF \uC9C0\uC18D \uC911 [[\uB300\uC2DC]]\uAC00
      \uBE68\uB77C\uC9C0\uACE0, \uB300\uC2DC \uACBD\uB85C\uC5D0 {val:3\uD68C} \uCC38\uACA9
      \uC0DD\uC131\n\u25CF \uC804\uC6A9 \uC720\uBB3C\uC774 \uC788\uC73C\uBA74 \uC801
      \uCC98\uCE58 \uC2DC {pos:\uC9C0\uC18D \uC2DC\uAC04 \uC99D\uAC00} {val:+1\uCD08}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883160
    m_Localized: "\u25CF \uBC88\uAC1C \uCC3D\uC73C\uB85C {val:3\uC5F0\uC18D} \uCC0C\uB974\uAE30\uC640
      \uB0B4\uB824\uCC0D\uAE30\n\u25CF \uACF5\uACA9\uB9C8\uB2E4 [[\uC804\uAE30 \uC18D\uC131]]
      \uCD95\uC801\uC744 \uB178\uB9BC\n\u25CF \uB9C8\uC9C0\uB9C9 \uD0C0\uACA9\uC740
      \uC804\uBC29\uC744 \uAC15\uD558\uAC8C \uC555\uBC15"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883161
    m_Localized: "[[\uB099\uB8B0 \uD45C\uC2DD]]\uC73C\uB85C \uB3CC\uC9C4\uD558\uACE0
      {em:\uD68C\uC218 \uCC3D}\uC744 \uC5BB\uC2B5\uB2C8\uB2E4. \uD45C\uC2DD\uC774
      \uC5C6\uC73C\uBA74 \uC804\uBC29\uC744 \uD729\uC4F8\uBA70 \uBAA8\uC544 \uB454
      \uCC3D\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883162
    m_Localized: "\u25CF \uCEE4\uC11C \uC8FC\uBCC0\uC5D0 [[\uB099\uB8B0 \uD45C\uC2DD]]\uC774
      \uC788\uC73C\uBA74 {em:\uB1CC\uCC3D \uB3CC\uACA9}\uC73C\uB85C \uC804\uD658\n\u25CF
      \uD45C\uC2DD\uC774 \uC5C6\uC73C\uBA74 {em:\uB1CC\uCC3D \uD729\uC4F8\uAE30}\uB85C
      \uC804\uBC29 \uACF5\uACA9\n\u25CF \uD45C\uC2DD \uB3CC\uACA9 \uC131\uACF5 \uC2DC
      {pos:\uB1CC\uCC3D \uB3CC\uACA9 \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04
      \uCD08\uAE30\uD654}\n\u25CF {em:\uD68C\uC218 \uCC3D} {val:1\uAC1C} \uD68D\uB4DD"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883163
    m_Localized: "\uC8FC\uBCC0\uC5D0 \uBC88\uAC1C \uCC3D\uC744 \uB5A8\uC5B4\uB728\uB824
      \uD53C\uD574\uB97C \uC8FC\uACE0 [[\uB099\uB8B0 \uD45C\uC2DD]]\uC744 \uB0A8\uAE41\uB2C8\uB2E4.
      \uD45C\uC2DD\uC740 {em:\uB1CC\uCC3D \uB3CC\uACA9}\uC758 \uBAA9\uD45C\uAC00
      \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883164
    m_Localized: "\u25CF \uD50C\uB808\uC774\uC5B4 \uC8FC\uBCC0 \uC804\uD22C \uAD6C\uC5ED\uC5D0
      [[\uB099\uB8B0 \uD45C\uC2DD]] {val:6\uAC1C} \uC0DD\uC131\n\u25CF \uCC3D\uC774
      \uAF42\uD790 \uB54C \uC57D\uD55C \uCC29\uC9C0 \uD53C\uD574\uB97C \uC8FC\uACE0
      \uD45C\uC2DD\uC740 {val:7\uCD08} \uC720\uC9C0\n\u25CF \uC0DD\uC131\uB41C \uD45C\uC2DD\uC740
      {em:\uB1CC\uCC3D \uB3CC\uACA9} \uB300\uC0C1\uC73C\uB85C \uC0AC\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883165
    m_Localized: "\u25CF \uB0A8\uC740 \uD0C4\uC57D\uC744 \uBAA8\uB450 \uC18C\uBAA8\uD574
      {em:\uB09C\uC0AC}\n\u25CF \uD0C4\uD658\uB9C8\uB2E4 {val:\uACE0\uC815 \uD53C\uD574
      100}\uACFC \uB109\uBC31 \uC801\uC6A9\n\u25CF {val:0.08\uCD08} \uAC04\uACA9,
      {val:15\uB3C4} \uD0C4\uD37C\uC9D0\uC73C\uB85C \uBC1C\uC0AC\n\u25CF \uC0AC\uC6A9
      \uD6C4 {neg:\uB0A8\uC740 \uD0C4\uC57D 0\uBC1C}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883166
    m_Localized: "\u25CF {val:\uC794\uD0C4 1\uBC1C}\uC744 \uC18C\uBE44\uD574 \uC9C1\uC120
      \uD0C4\uD658 \uBC1C\uC0AC\n\u25CF \uD0C4\uD658\uC740 {val:\uACE0\uC815 \uD53C\uD574
      100}\uACFC \uB109\uBC31\uC744 \uC801\uC6A9\n\u25CF \uC794\uD0C4\uC774 \uC5C6\uC73C\uBA74
      {neg:\uBE48 \uACA9\uBC1C}\uB85C \uC804\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883167
    m_Localized: "\u25CF {em:\uAE30\uBB18\uD55C \uC1E0\uB369\uC774}\uB97C \uB358\uC838
      \uC801\uC5D0\uAC8C {val:\uACE0\uC815 \uD53C\uD574 60}\uC744 \uC8FC\uACE0 \uBC00\uCCD0\uB0B4\uAE30\n\u25CF
      \uB358\uC9C4 \uBB34\uAE30\uB294 \uC18C\uBA78\uD558\uBA70 {neg:\uB2E4\uC2DC
      \uD68D\uB4DD \uBD88\uAC00}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883168
    m_Localized: "\u25CF \uC0AC\uC6A9 \uC989\uC2DC \uAC00\uC18D\uD558\uBA70, \uC720\uC9C0\uD560\uC218\uB85D
      \uB2E8\uACC4\uBCC4 \uCD94\uAC00 \uAC00\uC18D\n\u25CF \uC0AC\uC6A9 \uC2DC /
      {val:3\uCD08} \uD6C4 / {val:6\uCD08} \uD6C4 [[\uC774\uB3D9\uC18D\uB3C4]] \uBCF4\uB108\uC2A4
      {val:100% / 200% / 300%}\n\u25CF {em:\uB9C8\uC6B0\uC2A4 \uBC29\uD5A5\uC73C\uB85C
      \uAC15\uC81C \uC774\uB3D9}\n\u25CF \uD53C\uACA9, \uC801 \uCDA9\uB3CC \uB610\uB294
      \uACF5\uACA9 \uC2DC {neg:\uAC00\uC18D \uC989\uC2DC \uC885\uB8CC}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883169
    m_Localized: "\u25CF \uC804\uBC29\uC73C\uB85C \uACE0\uC18D \uBCA0\uAE30 \uACF5\uACA9\n\u25CF
      [[\uC774\uB3D9\uC18D\uB3C4]]\uC758 {val:x3}\uB9CC\uD07C \uD53C\uD574 \uBCF4\uB108\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883170
    m_Localized: "\uB2EC\uBE5B\uC774 \uB0A8\uAE34 \uC11C\uB298\uD568\uC774 \uAC80\uC2E0\uC744
      \uD0C0\uACE0 \uD750\uB974\uBA70, \uBCA0\uC5B4\uB0B8 \uC790\uB9AC\uC5D0 \uCC28\uAC00\uC6B4
      \uC228\uACB0\uC744 \uB0A8\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883171
    m_Localized: "\uCC30\uB098\uC5D0 \uC77C\uC0DD\uC758 \uC815\uC218\uB97C \uC3DF\uC544\uBD93\uB294
      \uAC1C\uD654 \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883172
    m_Localized: "\uB0A0\uC774 \uC2A4\uCE5C \uC790\uB9AC\uB9C8\uB2E4 \uD0DC\uC591\uC758
      \uC794\uC5F4\uC774 \uB0A8\uC544, \uCE7C\uB05D\uC774 \uC544\uC9C1 \uC2DD\uC9C0
      \uC54A\uC740 \uB4EF \uC228\uC744 \uC27D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883173
    m_Localized: "\uC220\uAE30\uC6B4\uC774 \uBC1C\uB05D\uC744 \uD0C0\uACE0 \uD37C\uC9C4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883174
    m_Localized: "\uAC00\uACA9\uB41C \uC21C\uAC04 \uB2E4\uB9AC\uC5D0 \uC2DC\uB044\uB7EC\uC6B4
      \uBC18\uC0AC \uAC10\uAC01\uC774 \uC2A4\uBA70\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883175
    m_Localized: "\uC801\uC744 \uBCA0\uC5B4\uB0B8 \uC21C\uAC04, \uB2E4\uB9AC \uB05D\uC5D0
      \uAC00\uBCCD\uACE0 \uB0A0\uCE74\uB85C\uC6B4 \uAD00\uC131\uC774 \uB0A8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883176
    m_Localized: "\uC9C0\uC6CC\uC9C0\uB294 \uC22B\uC790\uB9CC\uD07C \uBC1C\uAC78\uC74C\uC774
      \uAC00\uBCBC\uC6CC\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883177
    m_Localized: "\uC9D9\uC740 \uC5B4\uB460\uC774 \uC2DC\uC57C\uB97C \uAC00\uB824,
      \uBC1C\uBC11\uC744 \uC720\uC2EC\uD788 \uD655\uC778\uD558\uAC8C \uB9CC\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883178
    m_Localized: "\uADF8\uB9BC\uC790 \uC548\uAC1C\uAC00 \uB208\uC55E\uC744 \uB35C\uC5B4
      \uB0B4, \uC8FC\uBCC0\uC744 \uBD84\uAC04\uD558\uAE30 \uC5B4\uB835\uAC8C \uB9CC\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883179
    m_Localized: "\u25CF [[\uCCB4\uB825]] {pos:[+1]} \uD68C\uBCF5"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883180
    m_Localized: "\uD50C\uB808\uC774\uC5B4 \uC8FC\uC704\uB97C \uB3C4\uB294 \uAE43\uD138\uC744
      \uC0DD\uC131\uD569\uB2C8\uB2E4. \uB808\uBCA8\uC5D0 \uB530\uB77C \uACF5\uACA9\uB825\uC758
      35/45/55/65/75% \uD53C\uD574\uB97C \uC8FC\uBA70, \uC774\uB3D9\uC18D\uB3C4\uAC00
      \uB192\uC744\uC218\uB85D \uB354 \uBE60\uB974\uAC8C \uD68C\uC804\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883181
    m_Localized: "\uCE58\uBA85\uD0C0\uAC00 \uC544\uB2CC \uACF5\uACA9 \uC801\uC911
      \uC2DC \uCE58\uBA85\uD0C0 \uD655\uB960\uC774 2/3/4% \uC99D\uAC00\uD569\uB2C8\uB2E4.
      \uCD5C\uB300 8\uD68C \uC911\uCCA9\uB418\uBA70, \uCE58\uBA85\uD0C0 \uBC1C\uC0DD
      \uC2DC \uCD08\uAE30\uD654\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883182
    m_Localized: "\uAC1C\uD654 \uC804\uC6A9 \uC720\uBB3C\n\uAC1C\uD654 \uC911 \uC801
      \uCC98\uCE58 \uC2DC \uAC1C\uD654 \uC9C0\uC18D \uC2DC\uAC04\uC774 1\uCD08 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271744
    m_Localized: "\uC794\uC601\uC758 \uB0A0\uAC1C \uC804\uC6A9 \uC720\uBB3C\n\uC2A4\uD53C\uB4DC
      \uC2A4\uD2B8\uB77C\uC774\uD06C\uB85C \uC801\uC744 \uCC98\uCE58\uD558\uBA74
      \uB7EC\uC26C\uAC00 \uC885\uB8CC\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271745
    m_Localized: "[\uCE58\uBA85\uD0C0 \uC2DC] [\uC774\uB3D9\uC18D\uB3C4] 2% \uC529
      \uC99D\uAC00\n\uCD5C\uB300 50%\uAE4C\uC9C0 \uC99D\uAC00 \uAC00\uB2A5\n[\uD53C\uD574\uB97C
      \uBC1B\uC73C\uBA74 \uCD08\uAE30\uD654]"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271746
    m_Localized: "\uC794\uC601\uC758 \uB0A0\uAC1C \uC804\uC6A9 \uC720\uBB3C\n\uB7EC\uC26C\uC758
      \uC774\uB3D9\uC18D\uB3C4 \uBCF4\uB108\uC2A4\uAC00 \uC99D\uAC00\n\uB7EC\uC26C
      \uC0AC\uC6A9 \uC2DC [\uC774\uB3D9\uC18D\uB3C4] 150% \uC99D\uAC00\n3\uCD08 \uD6C4
      [\uC774\uB3D9\uC18D\uB3C4] 150% \uCD94\uAC00 \uC99D\uAC00\n3\uCD08 \uD6C4 [\uC774\uB3D9\uC18D\uB3C4]
      200% \uCD94\uAC00 \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271747
    m_Localized: "\uCE58\uBA85\uD0C0 \uC801\uC911 \uC2DC 3\uCD08 \uB3D9\uC548 \uCE58\uBA85\uD0C0
      \uD655\uB960\uC774 4/6/8/10/12% \uC99D\uAC00\uD569\uB2C8\uB2E4. \uCE58\uBA85\uD0C0
      \uC801\uC911 \uC2DC \uC9C0\uC18D \uC2DC\uAC04\uC774 \uCD08\uAE30\uD654\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271748
    m_Localized: "\u25CF \uCCB4\uB825\uC774 {min_ratio} \uC774\uC0C1\uC77C \uB54C
      [[{stat}]] {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271749
    m_Localized: "\u25CF [[\uCE58\uBA85\uD0C0]] \uC2DC [[\uC774\uB3D9\uC18D\uB3C4]]
      {move_speed_gain}\uC529 \uC99D\uAC00\n\u25CF \uCD5C\uB300 {max_move_speed_bonus}\uAE4C\uC9C0
      \uB204\uC801\n\u25CF \uD53C\uD574\uB97C \uBC1B\uC73C\uBA74 {neg:\uB204\uC801
      \uBCF4\uB108\uC2A4 \uCD08\uAE30\uD654}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271750
    m_Localized: "\u25CF {trigger} {duration} \uB3D9\uC548 [[{stat}]] {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271751
    m_Localized: "\u25CF \uCCB4\uB825\uC774 {max_ratio} \uC774\uD558\uC77C \uB54C
      [[{stat}]] {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271752
    m_Localized: "\u25CF {trigger} {duration} \uB3D9\uC548 [[{stat}]] {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271753
    m_Localized: "\u25CF {trigger} {duration} \uB3D9\uC548 [[{stat}]] {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271754
    m_Localized: "\u25CF {trigger} {duration} \uB3D9\uC548 [[{stat}]] {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271755
    m_Localized: "\u25CF {trigger} {duration} \uB3D9\uC548 [[{stat}]] {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271756
    m_Localized: "\u25CF {trigger} {duration} \uB3D9\uC548 [[{stat}]] {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271757
    m_Localized: "\u25CF {trigger} {duration} \uB3D9\uC548 [[{stat}]] {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271758
    m_Localized: "\u25CF [[\uD53C\uD574\uB97C \uBC1B\uC73C\uBA74]] {duration} \uB3D9\uC548
      [[\uC774\uB3D9\uC18D\uB3C4]] {move_speed_bonus}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271759
    m_Localized: "<color=#96DCFA>\u201C\uCDA9\uBD84\uD55C \uAC70\uB9AC\uB97C \uD655\uBCF4\uD55C
      \uB4A4 \uC0AC\uC6A9\uD558\uC2ED\uC2DC\uC624.\u201D\n\uC804 \uC0AC\uC6A9\uC790\uB294
      \uCDA9\uBD84\uD558\uB2E4\uB294 \uB9D0\uC744 \uC8FC\uAD00\uC801\uC778 \uAC1C\uB150\uC73C\uB85C
      \uBC1B\uC544\uB4E4\uC600\uB2E4.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271760
    m_Localized: "<color=#96DCFA>\uC228\uC774 \uB04A\uAE30\uAE30 \uC804 \uAC00\uC7A5
      \uBD89\uAC8C \uD53C\uB294 \uAF43. \uAC1C\uD654\uB294 \uADF8 \uD55C\uC21C\uAC04\uC744
      \uCE7C\uB0A0 \uC704\uC5D0 \uBD99\uC7A1\uC544 \uB454\uB2E4.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271761
    m_Localized: "<color=#96DCFA>\uBC88\uB729\uC774\uB294 \uC12C\uAD11\uC774 \uC2DC\uC57C\uB97C
      \uC2A4\uCE58\uAE30 \uC804, \uC801\uC758 \uC804\uC5F4\uC740 \uC774\uBBF8 \uAFF0\uB6AB\uB824
      \uC788\uB2E4.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271762
    m_Localized: "<color=#96DCFA>\uC7AC\uC7A5\uC804\uC740 \uC5C6\uB2E4. \uC5EC\uC12F
      \uBC1C\uC774 \uB05D\uB098\uBA74, \uC774\uC81C \uB358\uC9C8 \uC77C\uB9CC \uB0A8\uC740
      \uAE30\uBB18\uD55C \uC1F3\uB369\uC774.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271763
    m_Localized: "<color=#96DCFA>\u201C\uD55C \uBC88 \uC2DC\uC791\uB41C \uAE30\uC0AC\uC758
      \uB0A0\uAC2F\uC9D3\uC740 \uACB0\uCF54 \uBA48\uCD94\uC9C0 \uC54A\uB294\uB2E4.
      \uADF8 \uB05D\uC740 \uC624\uC9C1 \uC2B9\uB9AC \uD639\uC740 \uC644\uC804\uD55C
      \uC18C\uBA78\uBFD0\uC774\uB2E4.\u201D</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271764
    m_Localized: "\u25CF {em:\uC6A9\uC0AC\uC758 \uAC80} \uC804\uC6A9 \uC720\uBB3C\n\u25CF
      \uD68C\uC804\uBCA0\uAE30 \uCC28\uC9D5 \uC911 {pos:\uB3CC\uC9C4 \uCC0C\uB974\uAE30
      \uC0AC\uC6A9 \uAC00\uB2A5}\n\u25CF \uC0AC\uC6A9 \uC21C\uAC04\uC758 \uCC28\uC9D5
      \uC815\uB3C4\uC5D0 \uB530\uB77C \uB3CC\uC9C4 \uCC0C\uB974\uAE30\uC758 \uD53C\uD574\xB7\uD06C\uAE30\xB7\uC0C9\uC0C1
      \uBCC0\uD654\n\u25CF \uCD5C\uB300 \uCC28\uC9D5 \uC2DC \uB3CC\uC9C4 \uCC0C\uB974\uAE30
      \uD53C\uD574 \uC57D {val:1.67\uBC30}\n\u25CF \uB3CC\uC9C4 \uC911 \uBC84\uD2BC\uC744
      \uB193\uC73C\uBA74 {em:\uAC15\uD654 \uD68C\uC804\uBCA0\uAE30}\uB85C \uC5F0\uACC4"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271765
    m_Localized: "\u25CF {em:\uD64D\uB828\uC758 \uD55C\uACC4\uC120} \uC804\uC6A9
      \uC720\uBB3C\n\u25CF {em:\uC810\uD654!}\uB85C \uC801 \uCC98\uCE58 \uC2DC \uD574\uB2F9
      \uC704\uCE58\uC5D0\uC11C {em:\uCD94\uC801 \uD654\uC5FC\uD0C4} {val:1\uAC1C}
      \uC0DD\uC131\n\u25CF \uD654\uC5FC\uD0C4\uC740 \uAC00\uAE4C\uC6B4 \uC801\uC744
      \uCD94\uC801\n\u25CF \uCD94\uC801\uD560 \uC801\uC774 \uC5C6\uC73C\uBA74 \uC0DD\uC131\uB418\uC9C0
      \uC54A\uC73C\uBA70, \uCD94\uC801 \uD654\uC5FC\uD0C4\uC73C\uB85C\uB294 {neg:\uCD94\uAC00
      \uC0DD\uC131 \uBD88\uAC00}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271766
    m_Localized: "\u25CF {em:\uD64D\uB828\uC758 \uD55C\uACC4\uC120} \uC804\uC6A9
      \uC720\uBB3C\n\u25CF {em:\uB300\uD3ED\uBC1C!}\uC774 \uC801\uC744 \uAD00\uD1B5\uD558\uB294
      {em:\uAC70\uB300 \uC6A9\uC554\uAD6C \uBC1C\uC0AC}\uB85C \uC804\uD658\n\u25CF
      \uB300\uD3ED\uBC1C!\uC758 \uD53C\uD574\uC640 \uD06C\uAE30 \uC720\uC9C0\n\u25CF
      \uC6A9\uC554\uAD6C \uC18D\uB3C4\uB294 \uAE30\uBCF8 \uACF5\uACA9 \uD22C\uC0AC\uCCB4\uC758
      {val:75%}\n\u25CF \uBCBD\uC5D0 \uB2FF\uC73C\uBA74 \uC18C\uBA78"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271767
    m_Localized: "\u25CF {em:\uB1CC\uCC3D \uAC08\uB77C\uB860} \uC804\uC6A9 \uC720\uBB3C\n\u25CF
      \uB099\uB8B0 \uD45C\uC2DD\uC774 \uC801\uC758 \uC704\uCE58\uC5D0 {val:0.07\uCD08}
      \uAC04\uACA9\uC73C\uB85C \uC21C\uCC28 \uB099\uD558\n\u25CF \uD574\uB2F9 \uC704\uCE58\uC5D0
      \uB5A8\uC5B4\uC9C8 \uC218 \uC5C6\uAC70\uB098 \uB2E4\uB978 \uB1CC\uCC3D\uACFC
      \uB108\uBB34 \uAC00\uAE4C\uC6B0\uBA74 \uC801\uACFC \uAC00\uAE4C\uC6B4 \uBE48
      \uC704\uCE58\uC5D0 \uB099\uD558"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271768
    m_Localized: "\u25CF {em:\uB1CC\uCC3D \uAC08\uB77C\uB860} \uC804\uC6A9 \uC720\uBB3C\n\u25CF
      [[\uACF5\uACA9\uC18D\uB3C4]] {pos:[+20%]}\n\u25CF \uAE30\uBCF8 \uACF5\uACA9\uC758
      {val:\uC138 \uBC88\uC9F8 \uD0C0\uACA9} \uC2DC \uACF5\uACA9 \uB05D \uC9C0\uC810
      \uC8FC\uBCC0\uC758 \uC801\uC744 \uD5A5\uD574 \uB1CC\uCC3D {val:1\uAC1C} \uB099\uD558"
    m_Metadata:
      m_Items: []
  - m_Id: 50606298271769
    m_Localized: "\u25CF {em:\uAE30\uBB18\uD55C \uC1E0\uB369\uC774} \uC804\uC6A9
      \uC720\uBB3C\n\u25CF \uD0C4\uC57D\uC774 \uC5C6\uC744 \uB54C \uACF5\uACA9 \uB610\uB294
      {em:\uB09C\uC0AC} \uC785\uB825 \uC2DC \uC7AC\uC7A5\uC804\n\u25CF \uC7AC\uC7A5\uC804
      \uC644\uB8CC \uC2DC \uC720\uBB3C \uB808\uBCA8 {val:1}\uC744 \uC18C\uBAA8\uD574
      {pos:\uC644\uC804 \uC7A5\uC804}\n\u25CF \uC7A5\uC804 \uD6C4 \uB2E4\uC2DC \uC785\uB825\uD558\uBA74
      \uBC1C\uC0AC\n\u25CF \uC720\uBB3C \uB808\uBCA8\uC740 \uB0A8\uC740 \uC7A5\uC804
      \uD69F\uC218\uB97C \uC758\uBBF8\n\u25CF \uB808\uBCA8\uC774 {val:0}\uC774 \uB418\uBA74
      {neg:\uC720\uBB3C \uC18C\uBA78}"
    m_Metadata:
      m_Items: []
  - m_Id: 53708166434816
    m_Localized: "\uC5B4\uC11C \uC624\uC2ED\uC2DC\uC624, \uC6A9\uC0AC\uB2D8. \uB9C8\uC655\uB2D8\uC758
      \uC54C\uD604\uC2E4\uC740 \uC774 \uC55E\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458240
    m_Localized: "\uB2E4\uB9CC \uD604\uC7AC\uB294 \uC54C\uD604 \uC811\uC218\uAC00
      \uC5B4\uB835\uC2B5\uB2C8\uB2E4. \uB9C8\uC655\uB2D8\uAED8\uC11C \uBC00\uB9B0
      \uC5C5\uBB34\uB97C \uCC98\uB9AC \uC911\uC774\uC2DC\uB77C\uC11C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458241
    m_Localized: "\uC815\uD655\uD788\uB294\u2026 \uC544\uC8FC \uB9CE\uC774 \uBC00\uB824
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458242
    m_Localized: "\uB9C8\uC655\uB2D8\uAED8\uC11C\uB294 \uC6A9\uC0AC\uB2D8\uAED8 \uC774\uB807\uAC8C
      \uC804\uD558\uB77C \uD558\uC168\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458243
    m_Localized: "\u2018\uC544\uC9C1\uC740 \uC774\uB974\uB2E4. \uC131 \uC548\uC744
      \uB354 \uB458\uB7EC\uBCF4\uACE0, \uAC04\uBD80\uB4E4\uC758 \uC778\uC815\uC744
      \uBC1B\uC544 \uC624\uB3C4\uB85D.\u2019"
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458244
    m_Localized: "\uC138 \uAD6C\uC5ED\uC5D0 \uAC01\uAC01 \uAC04\uBD80\uB2D8\uB4E4\uC774
      \uACC4\uC2ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458245
    m_Localized: "\uADF8\uBD84\uB4E4 \uC911 \uC138 \uBD84\uAED8 \uC778\uC815\uC744
      \uBC1B\uC73C\uC2E0\uB2E4\uBA74, \uC774 \uBB38\uC740 \uC6A9\uC0AC\uB2D8\uC744
      \uC704\uD574 \uC5F4\uB9B4 \uAC83\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458246
    m_Localized: "\uBB3C\uB860\u2026 \uC790\uB9AC\uC5D0 \uACC4\uC2E0\uB2E4\uB294
      \uBCF4\uC7A5\uC740 \uC5C6\uC2B5\uB2C8\uB2E4. \uB9C8\uC655\uC131\uC740 \uC0DD\uAC01\uBCF4\uB2E4
      \uC790\uC720\uB85C\uC6B4 \uC9C1\uC7A5\uC774\uB77C\uC11C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458247
    m_Localized: "\uADF8\uB7FC \uD589\uC6B4\uC744 \uBE4C\uACA0\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458248
    m_Localized: "\uC870\uAC74\uC774 \uCDA9\uC871\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458249
    m_Localized: "\uC774\uC81C \uB9C8\uC655\uB2D8\uC744 \uC54C\uD604\uD558\uC2DC\uAE38."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458250
    m_Localized: "\uB9C8\uCE68\uB0B4 \uBB38\uC774 \uC5F4\uB838\uAD70. \uC601\uAC81\uACFC
      \uAC19\uC740 \uC2DC\uAC04 \uB3D9\uC548 \uC9C0\uB8E8\uD558\uB358 \uCC38\uC774\uC5C8\uB294\uB370
      \uB9D0\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458251
    m_Localized: "\uC5EC\uAE30\uAE4C\uC9C0 \uC624\uB2E4\uB2C8 \uC6B0\uC120 \uCE6D\uCC2C\uD574\uC8FC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458252
    m_Localized: "\uB124\uAC00 \uB9C8\uC655\uC778\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458253
    m_Localized: "\uBA3C\uC800 \uC628 \uB098\uC758 \uCE5C\uC6B0\uB97C \uC5B4\uB5BB\uAC8C
      \uD588\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458254
    m_Localized: "\uCE5C\uAD6C. \uC6A9\uC0AC\uB97C \uB9D0\uD558\uB294 \uAC74\uAC00.
      \uC774 \uC5BC\uB9C8\uB098 \uC9C4\uBD80\uD55C \uB9D0\uC778\uAC00... \uADF8\uB140\uB294...
      \uC74C..."
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458255
    m_Localized: "<color=purple>\uD478\uD558\uD558\uD558\uD558\uD558\uD558--!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458256
    m_Localized: ...?
    m_Metadata:
      m_Items: []
  - m_Id: 53708296458257
    m_Localized: "\uBB54\uAC00 \uAE30\uBB18\uD55C \uC6C3\uC74C \uC18C\uB9AC\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846848
    m_Localized: ....
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846849
    m_Localized: "(\uB9C8\uC655\uC740 \uC2A4\uC2A4\uB85C\uC758 \uAC80\uC744 \uC9C8\uCC45\uD558\uB4EF
      \uC8FC\uBA39\uC73C\uB85C \uAC00\uBCCD\uAC8C \uB450\uB4DC\uB838\uACE0, \uAC80\uC740
      \uBD80\uB974\uB974 \uB5A8\uB838\uB2E4.)"
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846850
    m_Localized: "\uD06C\uD760. \uC5B4\uCA0C\uB4E0. \uB108\uB294 \uADF8\uB140\uB97C
      \uCC3E\uAE30\uC5D0\uB294 \uB108\uBB34 \uB098\uC57D\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846851
    m_Localized: "\uD798\uC758 \uCC28\uC774\uB97C \uBCF4\uC5EC\uC8FC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846852
    m_Localized: "\uBCF4\uC2DC\uB2E4\uC2DC\uD53C, \uB108\uB294 \uD55C\uC5C6\uC774
      \uB098\uC57D\uD558\uACE0 \uCD08\uB77C\uD558\uB2E4. \uC774 \uC625\uC88C\uC5D0
      \uB2FF\uAE30\uC5D4 \uD131\uC5C6\uC774 \uBD80\uC871\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846853
    m_Localized: "\uD558\uC9C0\uB9CC \uB098\uB294 \uB108\uADF8\uB7EC\uC6B4 \uB9C8\uC655.
      \uAEBE\uC778 \uB0A0\uAC1C\uB85C \uBC1C\uBC84\uB465 \uCE58\uB294 \uC0C8\uB97C
      \uC9C0\uCF1C\uBCF4\uB294 \uAC83 \uB610\uD55C \uB098\uC758 \uC544\uB7C9\uC774\uB2C8,
      \uC800 \uC544\uB4DD\uD55C \uAD6C\uB369\uC774\uB85C \uB108\uB97C \uB358\uC838\uC8FC\uB9C8."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846854
    m_Localized: "\uC800 \uAE4A\uACE0 \uC5B4\uB450\uC6B4 \uAD6C\uB369\uC774 \uC18D\uC5D0\uC11C
      \uB2E4\uC2DC \uAE30\uC5B4 \uC62C\uB77C\uC640 \uBCF4\uAC70\uB77C. \uB0B4 \uC218\uD558\uB4E4\uC744
      \uC9C0\uB098 \uB2E4\uC2DC \uB098\uC5D0\uAC8C \uB2FF\uC744 \uC218 \uC788\uB2E4\uBA74
      \uBA87\uBC88\uC774\uACE0 \uC0C1\uB300\uD574\uC8FC\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846855
    m_Localized: "\uB2E8, \uB0B4 \uC778\uB0B4\uC2EC\uC740 \uBC14\uB2E5\uC744 \uD5A5\uD574
      \uB5A8\uC5B4\uC9C0\uB294 \uBAA8\uB798\uC54C\uACFC \uAC19\uB2E4. \uC815\uD655\uD788
      15\uBD84\uC774\uB2E4. \uADF8 \uC548\uC5D0 \uB0B4 \uC55E\uAE4C\uC9C0 \uB3C4\uB2EC\uD560
      \uD22C\uC9C0\uB97C \uBCF4\uC5EC\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846856
    m_Localized: "\uADF8\uB7FC. \uB2E4\uC74C \uB9CC\uB0A8\uC744 \uAE30\uB300\uD558\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846857
    m_Localized: "\uB108\uB294 \uC6A9\uC0AC\uC778\uAC00? \uBB50\uB0D0, \uADF8 \uBE48\uC57D\uD55C
      \uBAB8\uC740! \uADF8 \uBAB8\uC73C\uB85C \uAC10\uD788 \uB9C8\uC655\uB2D8\uAED8
      \uB364\uBE44\uACA0\uB2E4\uACE0? \uAE30\uD569\uC740 \uAC00\uC0C1\uD558\uB2E4\uB9CC,
      \uB2E8\uB828\uC774 \uD55C\uCC38 \uBD80\uC871\uD558\uAD70!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846858
    m_Localized: "\uB9C8\uC655\uB2D8\uC744 \uB54C\uB824\uB215\uD788\uACA0\uB2E4\uACE0?
      \uADF8 \uD130\uBB34\uB2C8\uC5C6\uC774 \uB192\uC740 \uBAA9\uD45C\uB294 \uB9C8\uC74C\uC5D0
      \uB4DC\uB294\uAD70! \uBAA9\uD45C\uAC00 \uB192\uC744\uC218\uB85D \uBAB8\uB3C4
      \uB354 \uB192\uC740 \uACF3\uAE4C\uC9C0 \uC62C\uB77C\uAC00\uB294 \uBC95\uC774\uB2C8\uAE4C!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846859
    m_Localized: "\uC88B\uB2E4! \uC774 \uBC84\uD53C\uAC00 \uC9C1\uC811 \uB2E8\uB828\uC2DC\uCF1C
      \uC8FC\uB9C8! \uC606\uC758 \uD6C8\uB828 \uAE30\uAD6C \uC14B \uC911 \uD558\uB098\uB97C
      \uACE8\uB77C \uB2F9\uC7A5 \uBAB8\uBD80\uD130 \uC6C0\uC9C1\uC5EC! \uC2E4\uC2DC!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846860
    m_Localized: "\uB4DC\uB514\uC5B4 \uC654\uAD70. \uC6A9\uC0AC. [pause=0.25]\uD6C4\uD6C4,
      \uCC38 [punch]\uB290\uB824 \uBE60\uC84C\uB124[/punch]."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846861
    m_Localized: "\uC790, \uC5B4\uB54C? \uB124 \uC624\uB79C \uC18C\uAFC9\uCE5C\uAD6C\uAC00
      [punch]\uB9C8\uC655[/punch]\uC774 \uB418\uC5B4\uC788\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846862
    m_Localized: "\uADF8\uAC8C \uBB34\uC2A8...! \uC138\uB1CC\uB77C\uB3C4 \uB2F9\uD55C\uAC70\uB0D0!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846863
    m_Localized: "... \uB108 \uADF8 \uC637 \uC9C4\uC9DC \uC548 \uC5B4\uC6B8\uB824..."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846864
    m_Localized: "\uC5ED\uC2DC \uC88B\uC740 \uBC18\uC751\uC774\uB124~ [pause=0.2]\uBB50,
      \uC138\uB1CC \uAC19\uC740 \uAC74 \uC544\uB2C8\uB2C8\uAE4C \uC548\uC2EC\uD558\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846865
    m_Localized: "\uBB50, \uC774\uCABD\uB3C4 \uB098\uB984 \uC0AC\uC815\uC774 \uC788\uAC70\uB4E0.
      [pause=0.25]\uC544\uC9C1 \uB9D0\uD574\uC904 \uC218 \uC5C6\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846866
    m_Localized: "[shake]\uD558\uC544!?![/shake] \uADF8\uAC8C \uBB34\uC2A8 \uBC18\uC751\uC774\uC57C!?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846867
    m_Localized: "\uAE30\uAECF \uC5F4\uC2EC\uD788 \uACE8\uB790\uB294\uB370 \uC870\uAE08\uC740
      [punch]\uCE6D\uCC2C\uD558\uB77C\uACE0[/punch]!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846868
    m_Localized: "\u2026\uC5B4\uCA0C\uB4E0... [pause=0.35]\uBD10\uC8FC\uC9C0 \uC54A\uC744
      \uAC70\uC57C. \uB098\uB3C4 \uC77C\uB2E8\uC740 \uB9C8\uC655\uC774\uB2C8\uAE4C.
      [pause=0.2]\uC790, [punch]\uCDA4\uCDB0\uBCF4\uC790\uACE0[/punch], \uC6A9\uC0AC!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708304846869
    m_Localized: "...\uB124\uAC00 \uC6A9\uC0AC\uC778\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041152
    m_Localized: "\uB098\uB294 \uC2A4\uD53C\uB9AC\uB2E4. \uBD89\uC740 \uC7AC\uC559\uC758
      \uC6A9... [pause=0.25]\uC2A4\uD53C\uB9AC."
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041153
    m_Localized: "\uC774\uC720\uB97C \uBAA8\uB974\uACA0\uAD70. \uB124\uB188\uC5D0\uAC8C\uC120...
      [pause=0.35]\uC544\uBB34 \uB0C4\uC0C8\uB3C4 \uB098\uC9C0 \uC54A\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041154
    m_Localized: "\uACF5\uD3EC\uB3C4. \uC0B4\uC758\uB3C4. \uC0DD\uC874 \uBCF8\uB2A5\uC870\uCC28."
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041155
    m_Localized: "...\uADF8 \uC815\uB3C4\uB85C \uC57D\uD55C \uAC74\uAC00? [pause=0.25]\uC544\uB2C8\uBA74
      \uC774\uBBF8 \uAC01\uC624\uB97C \uB05D\uB0B8 \uAC74\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041156
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041157
    m_Localized: "...\uBBF8\uC548\uD558\uC9C0\uB9CC \uC7A0\uC2DC \uAE30\uB2E4\uB824\uC8FC\uACA0\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041158
    m_Localized: "\uC9C0\uAE08\uC758 \uB098\uB294... [pause=0.35]\uADF8\uB2E4\uC9C0
      \uBC14\uB78C\uC9C1\uD55C \uC0C1\uD0DC\uAC00 \uC544\uB2C8\uB77C\uC11C."
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041159
    m_Localized: "(<size=110%>\uBC8C\uCEE5</size>)"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041160
    m_Localized: "(<size=115%>\uBC8C\uCEE5</size>)"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041161
    m_Localized: "(<size=110%>\uBC8C\uCEE5</size><size=115%>\uBC8C\uCEE5</size><size=120%>\uBC8C\uCEE5\uBC8C\uCEE5--!!</size>)"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041162
    m_Localized: "[slowshake][rand_size=95,112]\uD478\uD558\uC544\uC544\uC544\uC544\uC544----[/rand_size][/slowshake]!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041163
    m_Localized: "[slowshake][rand_size=95,110]\uD06C\uC73C\uC73C\uC73C\uC73C~[/rand_size][/slowshake]!
      \uC5ED\uC2DC \uC778\uAC04\uB4E4\uC758 [rand_size=95,108]\uC220\uC774[/rand_size]
      \uCD5C\uACE0\uB77C\uB2C8\uAE4C\uC544~! [rand_size=95,106]\uC0B4 \uAC83[/rand_size]
      \uAC19\uB124\uC5D0\uC5D0\uC5D0~!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041164
    m_Localized: "\uC624\uC624~ \uC6A9\uC0AC! [slowshake][rand_size=95,110]\uC548
      \uAC14\uB124\uC5D0\uC5D0[/rand_size][/slowshake]~!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041165
    m_Localized: "\uC790\uC790, \uADF8\uB807\uAC8C \uAD73\uC5B4 \uC788\uC9C0 \uB9D0\uACE0~
      [pause=0.2][rand_size=95,108]\uD55C \uC794[/rand_size] \uBC1B\uC544\uB77C!
      \uC2F8\uC6C0\uC740 [slowshake]\uCDE8\uD574\uC11C[/slowshake] \uD574\uC57C \uC81C\uB9DB\uC774\uB77C\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041166
    m_Localized: "\uBC29\uAE08 \uADF8\uAC74 \uB300\uCCB4 \uBB50\uC600\uC9C0...?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041167
    m_Localized: "\uC88B\uC544. \uC220\uC790\uB9AC\uB77C\uBA74 \uC0AC\uC591 \uC548
      \uD558\uC9C0!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041168
    m_Localized: "\uBC29\uAE08~?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041169
    m_Localized: "\uC73C\uD788\uD788... [pause=0.25][slowshake][rand_size=95,108]\uAE00\uC384\uC5D0[/rand_size][/slowshake]~?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041170
    m_Localized: "\uBABB \uBCF8 \uAC78\uB85C \uD574\uC8FC\uB77C~ [pause=0.2]\uB098\uB3C4
      [rand_size=95,105]\uAE30\uC5B5\uD558\uAE30[/rand_size] \uC2EB\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041171
    m_Localized: "\uC624\uC624\uC624~!! \uBD84\uC704\uAE30 \uD0C8 \uC904 \uC544\uB294
      [slowshake][rand_size=95,112]\uB140\uC11D\uC774\uC796\uB0D0[/rand_size][/slowshake]~!!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041172
    m_Localized: "\uC88B\uB2E4 \uC88B\uC544! \uC624\uB298\uC740 \uD2B9\uBCC4\uD788
      [rand_size=95,108]\uC6A9\uC0AC \uD658\uC601\uC8FC[/rand_size]\uB2E4~!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041173
    m_Localized: "\uC5B4\uB77C. [pause=0.25]\uC190\uC774 \uC65C [slowshake][rand_size=95,108]\uC138
      \uAC1C\uB85C[/rand_size][/slowshake] \uBCF4\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041174
    m_Localized: "\uC790, \uBAB8\uB3C4 [rand_size=95,108]\uB2EC\uC544\uC62C\uB790\uACE0[/rand_size]
      \uC2AC\uC2AC [slowshake]\uC2DC\uC791\uD574\uBCFC\uAE4C\uC544[/slowshake]~"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041175
    m_Localized: "[rand_size=95,106]\uC220 \uAE68\uAE30 \uC804\uC5D0[/rand_size]
      \uB05D\uB0B4\uC57C \uD558\uAC70\uB4E0. [pause=0.2]\uB108\uBB34 \uC624\uB798
      \uB04C\uC9C4 \uB9D0\uC790\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041176
    m_Localized: "\uC548 \uADF8\uB7EC\uBA74, \uC8FC\uBCC0\uC774 \uC880 [slowshake][rand_size=95,110]\uC704\uD5D8\uD574\uC838\uC11C[/rand_size][/slowshake]
      \uB9D0\uC774\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041177
    m_Localized: "\uBB34\uAE30\uBD80\uD130 \uC720\uBB3C\uAE4C\uC9C0 \uC5C6\uB294
      \uAC83 \uBE7C\uACE0 \uB2E4 \uC788\uC5B4! \uC5B4\uB514\uC11C \uAD6C\uD588\uB294\uC9C0\uB294
      \uBB3B\uC9C0 \uB9D0\uACE0, \uD5E4\uD5E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708309041178
    m_Localized: "\uC624\uC624, \uC5ED\uC2DC \uBCF4\uB294 \uB208\uC774 \uC788\uB124!
      \uC804\uBD80 \uB9C8\uC655\uC131\uC5D0\uC11C \uC5C4\uC120\uD55C \uADC0\uD55C
      \uBB3C\uAC74\uB4E4\uC774\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708321624064
    m_Localized: "\uC870\uAE08 \uC804\uAE4C\uC9C0 \uB204\uAD6C \uBB3C\uAC74\uC774\uC5C8\uB294\uC9C0\uB294
      \uC911\uC694\uD558\uC9C0 \uC54A\uC796\uC544? \uC9C0\uAE08\uC740 \uB0B4 \uAC70\uB2C8\uAE4C!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708321624065
    m_Localized: "\uBB50\uC5B4?! \uC9C4\uC9DC \uADF8\uB0E5 \uAC00\uAC8C?! \uC790,
      \uC7A0\uAE50\uB9CC! \uAD6C\uACBD\uC740 \uACF5\uC9DC\uB2C8\uAE4C \uC870\uAE08\uB9CC
      \uB354 \uBCF4\uACE0 \uAC00!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708321624066
    m_Localized: "\uBCF4\uB2E4 \uBCF4\uBA74 \uBD84\uBA85 \uC0AC\uACE0 \uC2F6\uC5B4\uC9C8
      \uAC70\uB77C\uAD6C!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708321624067
    m_Localized: "\uAC70\uAE30, \uD22C\uAD6C \uC4F4 \uC0AC\uB78C. \uADF8\uB798, \uC5EC\uAE30\uC800\uAE30
      \uB3CC\uC544\uB2E4\uB2C8\uB294 \uB108."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818368
    m_Localized: "\uB9C8\uC655\uC131 \uAD6C\uC870\uAC00 \uB610 \uBC14\uB00C\uC5C8\uAC70\uB4E0.
      \uAE38 \uC880 \uC678\uC6E0\uB2E4 \uC2F6\uC73C\uBA74 \uC774 \uBAA8\uC591\uC774\uC57C.
      \uB355\uBD84\uC5D0 \uBC30\uB2EC\uC774 \uC794\uB729 \uBC00\uB838\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818369
    m_Localized: "\uC5B4\uCC28\uD53C \uB2E4\uC74C \uAD6C\uC5ED\uC73C\uB85C \uAC08
      \uAC70\uBA74, \uC606\uC5D0 \uC313\uC778 \uC18C\uD3EC \uC880 \uAC00\uC838\uB2E4\uC904\uB798?
      \uAC70\uAE30 \uBC30\uC1A1 \uC0C1\uC790\uC5D0 \uB123\uC5B4 \uC8FC\uBA74 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818370
    m_Localized: "\uAC00\uBC29\uC5D0 \uB4E4\uC5B4\uAC08 \uB9CC\uD07C\uB9CC \uCC59\uACA8.
      \uC138 \uAC1C\uBA74 \uCDA9\uBD84\uD574. \uADF8 \uC774\uC0C1 \uB9E1\uACBC\uB2E4\uAC04
      \uB0B4\uAC00 \uB18D\uB561\uC774 \uD53C\uC6B4 \uC904 \uC54C \uAC70 \uC544\uB0D0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818371
    m_Localized: "\uB300\uC2E0 \uAC00\uC838\uAC04 \uAC74 \uB05D\uAE4C\uC9C0 \uBD80\uD0C1\uD574.
      \uB204\uAD70\uAC00\uB294 \uBAA9 \uBE60\uC9C0\uAC8C \uAE30\uB2E4\uB9AC\uB294
      \uBB3C\uAC74\uC774\uB2C8\uAE4C, \uAE38\uC5D0 \uBC84\uB9AC\uACE0 \uAC00\uBA74
      \uC548 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818372
    m_Localized: "\uBE48\uC190\uC73C\uB85C \uBD80\uD0C1\uD558\uB294 \uAC74 \uC544\uB2C8\uC57C.
      \uC18C\uD3EC \uD558\uB098\uB9C8\uB2E4 \uAF64 \uADC0\uD55C \uBB3C\uAC74\uC73C\uB85C
      \uC0AC\uB840\uD560\uAC8C. \uADF8 \uC815\uB3C4\uBA74 \uD574 \uBCFC \uB9CC\uD558\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818373
    m_Localized: "\uB09C \uC5EC\uAE30\uC11C \uB0A8\uC740 \uAC83 \uC880 \uC815\uB9AC\uD560
      \uD14C\uB2C8\uAE4C, \uC900\uBE44\uB418\uBA74 \uCC59\uACA8 \uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818374
    m_Localized: "...\uB9C8\uC655\uAD70 \uC18C\uC18D... [pause=0.25]\uCE68\uBB35\uC758
      \uAC04\uC218\uC7A5, \uADF8\uB9BC\uC790 \uC815\uB839 \uD074\uB85C\uC5D0. ...\uB3CC\uC544\uAC00.
      \uC5EC\uAE34... \uB108\uD76C\uAC00 \uC62C \uACF3\uC774 \uC544\uB2C8\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818375
    m_Localized: "...\uAC00\uAE4C\uC774 \uC624\uC9C0 \uB9C8. \uB0B4 \uADF8\uB9BC\uC790\uC5D0
      \uB2FF\uC544\uC11C \uC5B4\uB5BB\uAC8C \uB3FC\uB3C4... [tremble]\uB09C \uCC45\uC784
      \uBABB \uC838[/tremble]."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818376
    m_Localized: "\uB5A8\uACE0 \uC788\uB294 \uAC83 \uAC19\uC740\uB370. \uC0AC\uC2E4\uC740
      \uC2F8\uC6B0\uACE0 \uC2F6\uC9C0 \uC54A\uC740 \uAC70\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818377
    m_Localized: "\uC218\uC791 \uBD80\uB9AC\uC9C0 \uB9C8\uB77C! \uADF8\uAE5F \uADF8\uB9BC\uC790
      \uB530\uC704 \uBCA0\uC5B4\uBC84\uB9AC\uACA0\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818378
    m_Localized: "...\uC5B4?! \uC73C, \uC751...? \uC544, \uC544\uB2C8\uC57C! \uB098
      \uC5C4\uCCAD [punch]\uBB34\uC11C\uC6B4 \uC815\uB839[/punch]\uC774\uB780 \uB9D0\uC774\uC57C!
      \uB2E4\uB4E4 \uB098\uB9CC \uBCF4\uBA74 \uBC8C\uBC8C \uB5A4\uB2E4\uACE0...!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818379
    m_Localized: "...\uB108, \uC9C4\uC9DC \uC774\uC0C1\uD55C \uC778\uAC04\uC774\uC57C.
      \uB0B4 \uC9C4\uC2EC\uC744... [pause=0.3]\uBCF4\uD1B5\uC740 \uBB34\uC12D\uB2E4\uACE0
      \uB2E4 \uB3C4\uB9DD\uCE58\uB294\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818380
    m_Localized: "...\uADF8, \uADF8\uB798\uB3C4 \uC548 \uC2F8\uC6B8 \uC218\uB294
      \uC5C6\uC73C\uB2C8\uAE4C... [tremble]\uB108\uBB34 \uC544\uD504\uAC8C \uACF5\uACA9\uD558\uC9C4
      \uC54A\uC744\uAC8C[/tremble]..."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818381
    m_Localized: "...\uAC70\uBD10. \uC5ED\uC2DC \uC778\uAC04\uB4E4\uC740 \uB2E4 \uB611\uAC19\uC544.
      \uB0B4 \uC9C4\uC9DC \uB9C8\uC74C \uAC19\uC740 \uAC74... [pause=0.35]\uCC98\uC74C\uBD80\uD130
      \uBCF4\uB824\uACE0\uB3C4 \uC548 \uD558\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818382
    m_Localized: "...\uB9E8\uB0A0 \uC790\uAE30\uB4E4 \uBA4B\uB300\uB85C \uC624\uD574\uD558\uACE0...
      \uC774\uC820 \uB098\uB3C4 \uBAB0\uB77C. [punch]\uB2E4\uCE58\uB4E0 \uB9D0\uB4E0[/punch]
      \uB9C8\uC74C\uB300\uB85C \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818383
    m_Localized: "\u2026\uB9CE\uC774 \uB2E4\uCCD0\uB3C4 \uB09C \uCC45\uC784 \uBABB
      \uC838. \uC9C4\uC9DC\uB85C\u2026 [tremble]\uC544\uD50C \uD150\uB370[/tremble]..."
    m_Metadata:
      m_Items: []
  - m_Id: 53708325818384
    m_Localized: "\uB098\uB97C \uCC3E\uC544\uC628 \uAC74 \uB124\uAC00 \uCC98\uC74C\uC774
      \uC544\uB2C8\uC57C. [pause=0.25]\uADF8\uB9AC\uACE0 \uB9C8\uC9C0\uB9C9\uB3C4
      \uC544\uB2D0 \uAC70\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206976
    m_Localized: "\uADF8\uB798\uB3C4 \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uAC74 \uAE30\uC5B5\uD574\uB458\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206977
    m_Localized: "[shake]????[/shake] \uB108 \uC5B4\uB5BB\uAC8C \uC0B4\uC544\uC788\uB0D0?!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206978
    m_Localized: "\uC544\uB2C8, \uC88B\uC544. \uC774\uBC88\uC5D4 \uC870\uAE08 \uB354
      \uB611\uBC14\uB85C \uBD10\uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206979
    m_Localized: "\uC774\uC81C\uB294 [punch]\uADF8\uB9CC \uC880 \uCC3E\uC544\uC640[/punch]!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206980
    m_Localized: "\uB9E4\uBC88 \uC774\uB807\uAC8C \uB098\uD0C0\uB098\uBA74 \uB098\uB3C4
      \uBC18\uC751\uD558\uAE30 \uD798\uB4E4\uB2E4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206981
    m_Localized: "\uC774\uC81C \uC2AC\uC2AC \uC775\uC219\uD574\uC9C0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206982
    m_Localized: "\uB124\uAC00 \uC624\uB294 \uAC8C \uC774\uC0C1\uD558\uC9C0 \uC54A\uAC8C
      \uB290\uAEF4\uC9C0\uB294 \uAC83\uB3C4 \uC880 \uC774\uC0C1\uD558\uC9C0\uB9CC."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206983
    m_Localized: "\uC654\uAD6C\uB098. \uC0DD\uAC01\uBCF4\uB2E4 \uBE68\uB790\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206984
    m_Localized: "\uC774\uBC88\uC5D4 \uB124 \uC774\uC57C\uAE30\uB97C \uC870\uAE08
      \uB354 \uB4E4\uC5B4\uC904 \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206985
    m_Localized: "[punch]\uC624\uC624\uC624!?[/punch] \uB108 \uAF64 \uBE68\uB9AC
      \uC654\uB2E4!?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206986
    m_Localized: "\uADF8 \uC815\uB3C4 \uC5EC\uC720\uAC00 \uC788\uC73C\uBA74 \uD5C8\uC138
      \uC880 \uBD80\uB824\uB3C4 \uB418\uACA0\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206987
    m_Localized: "\uB108 \uACE7 \uC4F0\uB7EC\uC9C8 \uAC83 \uAC19\uC740 \uC5BC\uAD74\uC778\uB370?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206988
    m_Localized: "\uADF8\uB798\uB3C4 \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uB2E4\uB294
      \uAC74 \uC778\uC815\uD574\uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206989
    m_Localized: "\uC7A0\uAE50, \uB108 [tremble]\uADF8 \uBAB8\uC73C\uB85C[/tremble]
      \uC2F8\uC6B0\uB824\uACE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206990
    m_Localized: "\uBB34\uBAA8\uD55C \uAC74\uC9C0 \uB048\uC9C8\uAE34 \uAC74\uC9C0
      \uC544\uC9C1\uC740 \uBAA8\uB974\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206991
    m_Localized: "\uB610 \uC654\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206992
    m_Localized: "\uC88B\uC544. \uC774\uBC88\uC5D0\uB3C4 \uB124\uAC00 \uC5B4\uB514\uAE4C\uC9C0
      \uBC84\uD2F0\uB294\uC9C0 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206993
    m_Localized: "\uD638\uC624?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206994
    m_Localized: "\uB124\uAC00 \uADF8 \uC18C\uBB38\uC758 \uC6A9\uC0AC\uB85C\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206995
    m_Localized: "<size=120%>[punch]\uC7A0\uAE50.[/punch]</size> \uAC70\uAE30\uC11C
      \uBA48\uCD94\uAC70\uB77C!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206996
    m_Localized: "\uC774 \uBAB8\uC758 \uC218\uB85C\uC5D0 \uBC1C\uC744 \uB4E4\uC774\uAE30
      \uC804\uC5D0 \uBA3C\uC800 \uC2E0\uBC1C\uBD80\uD130 \uB2E6\uB294 \uAC83\uC774
      \uC608\uC758 \uC544\uB2C8\uB354\uB0D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206997
    m_Localized: "\uADF8 \uD759 \uBB3B\uC740 \uC2E0\uBC1C\uB85C \uD55C \uBC1C\uC9DD\uB9CC
      \uB354 \uB4E4\uC5B4\uC624\uBA74, \uC9D0\uC758 \uBC31\uC131\uB4E4\uC774 \uC138
      \uC2DC\uAC04 \uB3D9\uC548 \uAD11\uB0B8 \uBC14\uB2E5\uC774 \uB9DD\uAC00\uC9C0\uB290\uB2C8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206998
    m_Localized: "[float]\uBCF4\uC544\uB77C.[/float]"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334206999
    m_Localized: "\uC774 \uD22C\uBA85\uD55C \uBB3C\uAE38\uC744."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334207000
    m_Localized: "<size=110%>[float]\uBCF4\uC544\uB77C.[/float] \uC774 \uD2F0\uB04C
      \uD558\uB098 \uC5C6\uB294 \uD0C0\uC77C\uC744.</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334207001
    m_Localized: "<size=120%>[wave]\uC774\uAC83\uC774 \uBC14\uB85C \uC2AC\uB77C\uC784
      \uC655\uAD6D\uC758 \uAE0D\uC9C0.[/wave]</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334207002
    m_Localized: "<size=120%>[wave]\uB9C8\uC655\uC131 \uC9C0\uD558 \uC218\uB85C\uC758
      \uC9C4\uC815\uD55C \uC544\uB984\uB2E4\uC6C0\uC774\uB2C8\uB77C![/wave]</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334207003
    m_Localized: "\uADF8\uB9AC\uACE0 \uC9D0\uC740 \uADF8 \uBAA8\uB4E0 [slowshake][rand_size=98,106]\uB9D0\uCE89\uD55C[/rand_size][/slowshake]
      \uBC31\uC131\uB4E4\uC758 \uAD70\uC8FC."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334207004
    m_Localized: "<size=120%>\uC704\uB300\uD55C \uC2AC\uB77C\uC784\uB4E4\uC758 \uC5EC\uC655,
      \uBA5C\uD0C0\uB2E4!</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334207005
    m_Localized: "\uC815\uB9D0 \uD6CC\uB96D\uD55C \uC218\uB85C\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334207006
    m_Localized: "<size=120%>[wave]\uC624\uD638\uD638\uD638\uD638![/wave]</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 53708334207007
    m_Localized: "\uD6CC\uB96D\uD55C \uC218\uB85C\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 53708334207008
    m_Localized: "\uADF8\uB798, \uC544\uC8FC \uC815\uD655\uD55C \uD3C9\uAC00\uB85C\uAD6C\uB098!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401280
    m_Localized: "\uC9D0\uC758 \uBC31\uC131\uB4E4\uC774 \uB4E4\uC73C\uBA74 \uAE30\uBED0\uD558\uACA0\uAD70."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401281
    m_Localized: "\uC544\uB2C8, \uC774\uBBF8 \uB4E3\uACE0 \uC788\uACA0\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401282
    m_Localized: "\uB2E4\uB4E4 \uC228\uC5B4\uC11C \uBCF4\uACE0 \uC788\uC73C\uB2C8
      \uB9D0\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401283
    m_Localized: "\uC88B\uC544. \uADF8\uB300\uC5D0\uAC8C\uB294 \uD2B9\uBCC4\uD788
      \uD488\uACA9 \uC788\uB294 \uD328\uBC30\uB97C \uD5C8\uB77D\uD558\uB9C8!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401284
    m_Localized: "\uC2AC\uB77C\uC784 \uCE58\uACE0\uB294 \uAF64 \uAE68\uB057\uD558\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401285
    m_Localized: "[tremble]...\uC2AC\uB77C\uC784 \uCE58\uACE0\uB294?[/tremble]"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401286
    m_Localized: "\uC9C0\uAE08 \uB124\uB188, [pause=0.2] \uC9D0\uC758 \uBC31\uC131\uB4E4\uC744
      [tremble]\uC595\uBCF8 \uAC83\uC774\uB0D0?[/tremble]"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401287
    m_Localized: "<size=120%>\uC2AC\uB77C\uC784\uC740 \uC0F4\uD478\uB3C4, \uC824\uB9AC\uB3C4,
      \uC5F0\uAE08\uC220 \uC7AC\uB8CC\uB3C4 \uC544\uB2C8\uB2E4!</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401288
    m_Localized: "\uC6C0\uC9C1\uC774\uACE0, \uC0DD\uAC01\uD558\uACE0,"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401289
    m_Localized: "\uADFC\uBB34 \uAD50\uB300\uD45C\uAE4C\uC9C0 \uC791\uC131\uD558\uB294
      \uB2F9\uB2F9\uD55C \uBC31\uC131\uC774\uB2C8\uB77C!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401290
    m_Localized: "\uC88B\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401291
    m_Localized: "\uB124\uB188\uC740 \uD2B9\uBCC4\uD788 \uC608\uC808 \uAD50\uC721\uBD80\uD130
      \uBC1B\uC544\uC57C\uACA0\uAD6C\uB098."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401292
    m_Localized: "\uB9C8\uC655\uB2D8\uAED8\uC11C \uB124\uB188\uC744 \uC801\uB2F9\uD788
      \uBD10\uC8FC\uB77C \uBA85\uD558\uC168\uC73C\uB2C8, \uC9D0\uB3C4 \uADF8 \uB73B\uC740
      \uB530\uB974\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401293
    m_Localized: "\uD5C8\uB098 \uC774\uACF3\uC740 \uC9D0\uC758 \uC655\uAD6D."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401294
    m_Localized: "\uC5EC\uC655\uC758 \uC55E\uC744 \uC9C0\uB098\uAC00\uB824\uBA74,
      \uADF8\uB9CC\uD55C \uC790\uACA9\uC744 \uBCF4\uC774\uAC70\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401295
    m_Localized: "\uC790, \uB098\uC758 \uADC0\uC5EC\uC6B4 [slowshake][rand_size=98,106]\uBC31\uC131\uB4E4\uC774\uC5EC[/rand_size][/slowshake]!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401296
    m_Localized: "<size=110%>[punch]\uC904\uC744 \uB9DE\uCDB0\uB77C![/punch]</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401297
    m_Localized: "<size=120%>[wave]\uB300\uD615\uC740 \uB113\uAC8C![/wave]</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401298
    m_Localized: "<size=130%>[punch]\uBB34\uB840\uD55C \uC6A9\uC0AC\uB97C \uB9D0\uCE89\uD558\uAC8C
      \uC9D3\uB20C\uB7EC\uB77C!![/punch]</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401299
    m_Localized: "\uC624, \uC654\uC5B4? \uC624\uB298\uC740 \uB610 \uBB58 \uB450\uB4E4\uACA8
      \uC904\uAE4C!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401300
    m_Localized: "\uB9C8\uC815\uC11D\uB9CC \uB450\uB451\uD558\uAC8C \uCC59\uACA8\uC654\uB2E4\uBA74,
      \uB0B4 \uB9DD\uCE58\uB85C \uC544\uC8FC \uD654\uB048\uD558\uAC8C \uBCBC\uB824\uC8FC\uC9C0!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401301
    m_Localized: "\uC5C5\uADF8\uB808\uC774\uB4DC\uB97C \uBD80\uD0C1\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401302
    m_Localized: "\uC88B\uC544, \uC2DC\uC6D0\uC2DC\uC6D0\uD574\uC11C \uB9C8\uC74C\uC5D0
      \uB4DC\uB124!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401303
    m_Localized: "\uC544\uC9C1 \uACB0\uC815\uD558\uC9C0 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401304
    m_Localized: "\uBB50\uC57C, \uAE30\uAECF \uB9DD\uCE58\uC9C8\uD560 \uC0DD\uAC01\uC5D0
      \uC2E0\uB098\uC11C \uD654\uB85C\uAE4C\uC9C0 \uBC8C\uAC8B\uAC8C \uB2EC\uAD88
      \uB1A8\uB354\uB2C8!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401305
    m_Localized: "...\uCCC7, \uC54C\uC558\uC5B4. \uB9D8 \uC815\uD574\uC9C0\uBA74
      \uB2E4\uC2DC \uC640. \uB2E4\uC74C\uC5D4 \uC0AC\uB78C \uAE30\uB300\uD558\uAC8C
      \uB9CC\uB4E4\uC5B4 \uB193\uACE0 \uBE7C\uAE30 \uC5C6\uAE30\uB2E4?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401306
    m_Localized: "\uB2F9\uC7A5 \uD654\uB85C\uC5D0 \uBD88\uBD80\uD130 \uC9C0\uD544
      \uD14C\uB2C8\uAE4C, \uBB58 \uC5B4\uB5BB\uAC8C \uB72F\uC5B4\uACE0\uCE60\uC9C0
      \uB611\uBC14\uB85C \uACE8\uB77C\uBCF4\uB77C\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401307
    m_Localized: "\uB108\uCC98\uB7FC '\uC774\uBC88\uC5D4 \uB2E4\uB974\uB2E4'\uBA70
      \uAE30\uC138\uB4F1\uB4F1\uD558\uAC8C \uB098\uAC14\uB2E4\uAC00 \uB9C8\uC655\uC131
      \uBC14\uB2E5 \uCCAD\uC18C\uB9CC \uD558\uACE0 \uAD74\uB7EC\uB5A8\uC5B4\uC9C4
      \uB140\uC11D\uB4E4\uC774 \uD55C \uBB34\uB354\uAE30\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401308
    m_Localized: "\uB610 \uC950\uC5B4\uD130\uC838\uC11C \uC624\uBA74 \uC5C4\uCCAD
      \uBE44\uC6C3\uC5B4\uC904 \uD14C\uB2C8\uAE4C, \uD798\uB0B4 \uBD10!"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401309
    m_Localized: "\uC900\uBE44 \uB2E4 \uB05D\uB0AC\uC73C\uBA74 \uC800\uAE30 \uBB38\uC73C\uB85C
      \uB098\uAC00\uBA74 \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401310
    m_Localized: "\uC544, \uBBF8\uB9AC \uB9D0\uD574\uB450\uB294\uB370 \uC800 \uBB38
      \uBC16\uC73C\uB85C \uB098\uAC00\uBA74 \uC584\uC9E4\uC5C6\uC774 \uC77C\uBC29\uD1B5\uD589\uC774\uB2E4?"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401311
    m_Localized: "\uB098\uC911\uC5D0 \uBB50 \uB450\uACE0 \uC654\uB2E4\uACE0 \uBC16\uC5D0\uC11C
      \uC5C9\uC5C9 \uC6B8\uC5B4\uB3C4 \uBABB \uB3CC\uC544\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401312
    m_Localized: "\uC800\uAE30 \uC313\uC5EC \uC788\uB294 \uAC83\uB4E4 \uBCF4\uC774\uC9C0?
      \uB108\uCC98\uB7FC \uC774 \uAD6C\uB369\uC774\uC5D0 \uB5A8\uC5B4\uC9C4 \uB140\uC11D\uB4E4\uC774
      \uB0A8\uAE34 \uBB3C\uAC74\uB4E4\uC744 \uB0B4\uAC00 \uC4F8 \uB9CC\uD558\uAC8C
      \uC190 \uC880 \uBD10\uB454 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401313
    m_Localized: "\uB9E8\uC190\uC73C\uB85C \uB364\uBE4C \uC0DD\uAC01 \uC544\uB2C8\uBA74
      \uC800\uAE30\uC11C \uD558\uB098 \uCC59\uACA8\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401314
    m_Localized: "\uBB34\uAE30 \uACE8\uB790\uC73C\uBA74 \uADF8 \uC606\uC5D0 \uD5C8\uC218\uC544\uBE44\uD55C\uD14C
      \uC190\uBD80\uD130 \uC880 \uD480\uC5B4\uBCF4\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401315
    m_Localized: "\uC5C4\uD55C \uB370\uC11C \uD5DB\uC2A4\uC719\uD558\uB2E4 \uB610
      \uBC14\uB2E5\uC73C\uB85C \uAD74\uB7EC\uB5A8\uC5B4\uC9C0\uC9C0 \uB9D0\uACE0."
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401316
    m_Localized: "\uB300\uC26C \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774
      {reduction} \uAC10\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401317
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC \uC5BB\uB294 \uAE08\uD654\uC758 \uD68D\uB4DD\uB7C9\uC774
      {bonus} \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401318
    m_Localized: "\uACBD\uD5D8\uCE58 \uD68D\uB4DD\uB7C9\uC774 {bonus} \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401319
    m_Localized: "\u25CF [[\uD53C\uD574\uB97C \uBC1B\uC73C\uBA74]] {duration} \uB3D9\uC548
      [[\uC774\uB3D9\uC18D\uB3C4]] {move_speed_bonus}"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401320
    m_Localized: "\u25CF [[\uCE58\uBA85\uD0C0]] \uC2DC [[\uC774\uB3D9\uC18D\uB3C4]]
      {move_speed_gain}\uC529 \uC99D\uAC00\n\u25CF \uCD5C\uB300 {max_move_speed_bonus}\uAE4C\uC9C0
      \uB204\uC801\n\u25CF \uD53C\uD574\uB97C \uBC1B\uC73C\uBA74 {neg:\uB204\uC801
      \uBCF4\uB108\uC2A4 \uCD08\uAE30\uD654}"
    m_Metadata:
      m_Items: []
  - m_Id: 53708338401321
    m_Localized: "\u25CF {trigger} {duration} \uB3D9\uC548 [[{stat}]] {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 57923555201024
    m_Localized: "\u25CF [[\uCD94\uAC00 \uC774\uB3D9\uC18D\uB3C4]] {bonus_move_step}\uB9C8\uB2E4
      [[\uCE58\uBA85\uD0C0 \uD655\uB960]] {crit_gain_per_step} \uCD94\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556096
    m_Localized: "\u25CF [[\uCD94\uAC00 \uC774\uB3D9\uC18D\uB3C4]] {bonus_move_step}\uB9C8\uB2E4
      [[\uACF5\uACA9\uC744 \uD68C\uD53C\uD560 \uD655\uB960]] {evasion_gain_per_step}
      \uCD94\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556097
    m_Localized: "\u25CF \uAE43\uD138 {feather_count}\uAC1C\uAC00 \uC8FC\uC704\uB97C
      \uD68C\uC804\uD558\uBA70 \uC801\uC744 \uACF5\uACA9\n\u25CF \uAE43\uD138 \uD53C\uD574\uB294
      [[\uACF5\uACA9\uB825]]\uC758 {damage_coef}\n\u25CF \uD68C\uC804 \uBC18\uACBD
      {radius}\n\u25CF \uAC19\uC740 \uC801\uC744 \uB2E4\uC2DC \uACF5\uACA9\uD558\uB294
      \uAE30\uBCF8 \uAC04\uACA9 {hit_cooldown}"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556098
    m_Localized: "\u25CF {em:\uAC1C\uD654} \uC804\uC6A9 \uC720\uBB3C\n\u25CF {em:\uAC1C\uD654
      \uC0C1\uD0DC}\uC5D0\uC11C \uC801 \uCC98\uCE58 \uC2DC {pos:\uC9C0\uC18D \uC2DC\uAC04
      \uC99D\uAC00} {extension_seconds}"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556099
    m_Localized: "\u25CF \uACF5\uACA9 \uC801\uC911 \uC2DC \uC8FC\uBCC0 \uC801\uC5D0\uAC8C
      {em:\uBC88\uAC1C \uCD94\uAC00\uD0C0}\n\u25CF \uBC88\uAC1C \uD53C\uD574 {lightning_damage}\n\u25CF
      \uBC94\uC704 {radius}\n{cooldown_line}"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556100
    m_Localized: "\u25CF \uC801 \uCC98\uCE58 \uC2DC {duration} \uB3D9\uC548 [[\uACF5\uACA9\uB825]]
      {attack_bonus}\n\u25CF [[\uC774\uB3D9\uC18D\uB3C4]] {move_speed_bonus}"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556101
    m_Localized: "\u25CF {em:\uC794\uC601\uC758 \uB0A0\uAC1C} \uC804\uC6A9 \uC720\uBB3C\n\u25CF
      {em:\uC2A4\uD53C\uB4DC \uC2A4\uD2B8\uB77C\uC774\uD06C}\uB85C \uC801 \uCC98\uCE58
      \uC2DC {pos:\uB7EC\uC26C \uC720\uC9C0}"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556102
    m_Localized: "\u25CF \uCCB4\uB825\uC774 {min_ratio}~{max_ratio}\uC77C \uB54C
      [[{stat}]] {value}"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556103
    m_Localized: "\u25CF {em:\uC794\uC601\uC758 \uB0A0\uAC1C} \uC804\uC6A9 \uC720\uBB3C\n\u25CF
      {em:\uB7EC\uC26C}\uC758 \uC774\uB3D9\uC18D\uB3C4 \uBCF4\uB108\uC2A4 \uBCC0\uACBD\n\u25CF
      \uC0AC\uC6A9 \uC2DC [[\uC774\uB3D9\uC18D\uB3C4]] {stage_0_bonus}\n\u25CF {val:3\uCD08}
      \uD6C4 [[\uC774\uB3D9\uC18D\uB3C4]] {stage_1_bonus} \uCD94\uAC00, \uCD1D {stage_1_total}\n\u25CF
      {val:6\uCD08} \uD6C4 [[\uC774\uB3D9\uC18D\uB3C4]] {stage_2_bonus} \uCD94\uAC00,
      \uCD1D {stage_2_total}"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556104
    m_Localized: "\uB0C9\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556105
    m_Localized: "\uB0C9\uAE30\uAC00 \uB192\uC744\uC218\uB85D \uD0DC\uC591\uB3C4\uC758
      \uC77C\uBC18 \uACF5\uACA9\uC774 \uAC15\uD654\uB418\uACE0, \uACF5\uBA85 \uD53C\uB2C8\uC2DC
      \uC870\uAC74\uC73C\uB85C \uC0AC\uC6A9\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556106
    m_Localized: "\uAC1C\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556107
    m_Localized: "\uACF5\uACA9\uB825, \uACF5\uACA9\uC18D\uB3C4, \uC774\uB3D9\uC18D\uB3C4\uAC00
      \uC99D\uAC00\uD558\uACE0 \uB300\uC2DC \uCC38\uACA9\uC774 \uD65C\uC131\uD654\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556108
    m_Localized: "\uC5F4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556109
    m_Localized: "\uC5F4\uAE30\uAC00 \uB192\uC744\uC218\uB85D \uC6D4\uC601\uB3C4\uC758
      \uC77C\uBC18 \uACF5\uACA9\uC774 \uAC15\uD654\uB418\uACE0, \uACF5\uBA85 \uD53C\uB2C8\uC2DC
      \uC870\uAC74\uC73C\uB85C \uC0AC\uC6A9\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556110
    m_Localized: "\uC220 \uC7A5\uD310"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556111
    m_Localized: "\uC774\uB3D9 \uC18D\uB3C4 +25%, \uACF5\uACA9 \uC18D\uB3C4 +40%."
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556112
    m_Localized: "\uBC18\uACA9 \uC900\uBE44"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556113
    m_Localized: "\uD53C\uD574\uB97C \uBC1B\uC73C\uBA74 \uC7A0\uC2DC \uC774\uB3D9\uC18D\uB3C4\uAC00
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556114
    m_Localized: "\uC9C8\uC8FC\uC758 \uC5EC\uC6B4"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556115
    m_Localized: "\uC801 \uCC98\uCE58 \uC2DC \uC7A0\uC2DC \uC774\uB3D9\uC18D\uB3C4\uAC00
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556116
    m_Localized: "\uB2EC\uB9AC\uB294 \uC7A5\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556117
    m_Localized: "\uCE58\uBA85\uD0C0 \uC2DC \uC774\uB3D9\uC18D\uB3C4 \uC2A4\uD0DD\uC774
      \uC313\uC774\uACE0, \uD53C\uD574\uB97C \uBC1B\uC73C\uBA74 \uCD08\uAE30\uD654\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556118
    m_Localized: "\uC2DC\uC57C \uC81C\uD55C"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556119
    m_Localized: "\uD50C\uB808\uC774\uC5B4\uC758 \uC2DC\uC57C\uAC00 \uC77C\uC2DC\uC801\uC73C\uB85C
      \uC904\uC5B4\uB4E4\uACE0, \uC5B4\uB460 \uB9C8\uC2A4\uD06C\uAC00 \uD65C\uC131\uD654\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556120
    m_Localized: "\uC2DC\uC57C \uCC28\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556121
    m_Localized: "\uADF8\uB9BC\uC790 \uC548\uAC1C\uC5D0 \uC811\uCD09\uD55C \uB3D9\uC548
      \uD50C\uB808\uC774\uC5B4\uC758 \uC2DC\uC57C\uAC00 \uC77C\uC2DC\uC801\uC73C\uB85C
      \uCC28\uB2E8\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57923735556122
    m_Localized: "\uC5B4\uC774, \uAC70\uAE30! \uC5EC\uAE34 \uBABB \uC9C0\uB098\uAC00!"
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750400
    m_Localized: "\uC544\uB2C8. \uB531\uD788 \uB9C9\uB294 \uAC8C \uC544\uB2C8\uB77C
      \uAE38\uC774 \uC5C6\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750401
    m_Localized: "\uC608\uC804 \uC6A9\uC0AC\uAC00 \uB0A0\uB6F0\uBA74\uC11C \uAE38\uC774
      \uC644\uC804\uD788 \uB9C9\uD614\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750402
    m_Localized: "\uACF5\uC0AC \uB300\uAE08\uC774 \uC544\uC9C1 \uC548 \uB4E4\uC5B4\uC640\uC11C
      \uC791\uC5C5\uC774 \uBD88\uAC00\uB2A5\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750403
    m_Localized: "\uC815\uB9D0\uB85C? \uADF8\uB7FC \uACF5\uC0AC\uB97C \uC2DC\uC791\uD560\uAC8C!
      \uC544\uB9C8 3\uC77C \uD6C4 \uC988\uC74C \uC624\uBA74 \uB420 \uAC70\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750404
    m_Localized: "\uB9C8\uC815\uC11D\uC774 \uBD80\uC871\uD55C\uB370?"
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750405
    m_Localized: "\uB9C8\uC815\uC11D\uC774 \uBD80\uC871\uD55C\uB370?"
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750406
    m_Localized: "\uB108\uAD6C\uB098! \uACE0\uB9C8\uC6CC \uCE5C\uAD6C. \uB355\uBD84\uC5D0
      \uACF5\uC0AC \uC911\uC774\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750407
    m_Localized: "\uC55E\uC73C\uB85C {remaining_runs} \uC815\uB3C4 \uB0A8\uC558\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750408
    m_Localized: "\uACF5\uC0AC\uB294 \uC798 \uB9C8\uBB34\uB9AC \uB410\uC5B4, \uBCFC
      \uC77C \uBCF4\uB7EC \uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750409
    m_Localized: "\uACF5\uC0AC \uB300\uAE08\uC774 \uBD80\uC871\uD55C \uAC83 \uAC19\uC544.
      \uB9C8\uC815\uC11D\uC744 \uB354 \uBAA8\uC544 \uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750410
    m_Localized: "\uC624\uC624! \uC5EC\uC655\uB2D8\uC758 \uCE5C\uC6B0\uAD6C\uB098.\r\n\uC5EC\uC655\uB2D8\uC774
      \uB124\uAC00 \uC218\uB85C\uB97C \uC4F0\uB294 \uAC83\uC744 \uD5C8\uB77D\uD574\uC92C\uC5B4.
      \uB9D0\uB9CC\uD574.\r\n\uBC18\uB300\uD3B8\uAE4C\uC9C0 \uBE60\uB974\uAC8C \uB370\uB824\uB2E4
      \uC904\uAC8C"
    m_Metadata:
      m_Items: []
  - m_Id: 57923739750411
    m_Localized: "\uB108. \uC6A9\uC0AC\uC778\uAC00.\n\uC5EC\uAE34 \uC218\uB85C\uC758
      \uC2DC\uC791 \uC9C0\uC810\uC774\uC57C.\n\uC6D0\uD558\uB294 \uAD6C\uC5ED\uC73C\uB85C
      \uBC14\uB85C \uC774\uB3D9\uD560 \uC218 \uC788\uC9C0.\n\uC9C0\uB098\uAC00\uAC8C
      \uD574\uC8FC\uACE0 \uC2F6\uC9C0\uB9CC, \uC544\uC9C1 \uC5EC\uC655\uB2D8\uC774
      \uD5C8\uB77D\uD574\uC8FC\uC9C0 \uC54A\uC744 \uAC70\uC57C.\n\uC6A9\uC0AC\uAC00
      \uC218\uC9C8\uC744 \uC624\uC5FC \uC2DC\uD0A8\uB2E4\uACE0 \uB9D0\uC774\uC9C0.\n\uC774\uC6A9\uD558\uACE0
      \uC2F6\uB2E4\uBA74 \uC5EC\uC655\uB2D8\uC758 \uD5C8\uB77D\uC744 \uBC1B\uACE0
      \uC640.\t"
    m_Metadata:
      m_Items: []
