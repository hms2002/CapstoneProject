  - m_Id: 46294717337615
    m_Localized: "\uC131\uC7A5\uC758 \uC0C8\uC2F9"
    m_Metadata:
      m_Items: []
  - m_Id: 46294717337616
    m_Localized: "\uACBD\uD5D8\uCE58 \uD68D\uB4DD\uB7C9\uC774 10% \uC99D\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 46294717337617
    m_Localized: "\uC1A1\uACE8\uB9E4\uC758 \uC99D\uD45C"
    m_Metadata:
      m_Items: []
  - m_Id: 46294717337618
    m_Localized: "\uCD94\uAC00 \uC774\uB3D9\uC18D\uB3C4 20%\uB9C8\uB2E4 \uACF5\uACA9
      \uD68C\uD53C \uD655\uB960\uC774 3% \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294717337619
    m_Localized: "\uBB34\uAC70\uC6B4 \uD314\uCC0C"
