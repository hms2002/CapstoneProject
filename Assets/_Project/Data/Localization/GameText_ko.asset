      m_Items: []
  - m_Id: 50606285688878
    m_Localized: "\uAC80\uC744 \uC5F0\uC18D\uC73C\uB85C \uD718\uB450\uB985\uB2C8\uB2E4.
      \uB9C8\uC9C0\uB9C9 \uACF5\uACA9\uC740 \uC55E\uC73C\uB85C \uB098\uC544\uAC00\uBA70
      \uD06C\uAC8C \uBCA0\uC5B4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688879
    m_Localized: "\u25CF \uAC80\uC744 \uD718\uB458\uB7EC {val:3\uC5F0\uC18D} \uADFC\uC811
      \uACF5\uACA9\n\u25CF \uC138 \uBC88\uC9F8 \uACF5\uACA9\uC740 \uB354 \uAE38\uAC8C
      \uC804\uC9C4\uD558\uBA70 \uD06C\uAC8C \uBCA0\uC5B4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688880
    m_Localized: "\uB204\uB974\uACE0 \uC788\uB2E4\uAC00 \uB193\uC73C\uBA74 \uD68C\uC804\uD558\uBA70
      \uC8FC\uBCC0\uC744 \uBCB1\uB2C8\uB2E4. \uCDA9\uBD84\uD788 \uCDA9\uC804\uD574\uC57C
      \uBC1C\uB3D9\uD558\uBA70, \uC624\uB798 \uCDA9\uC804\uD560\uC218\uB85D \uB354
      \uB113\uACE0 \uAC15\uD574\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688881
    m_Localized: "\u25CF \uAE38\uAC8C \uB20C\uB7EC \uCC28\uC9D5\uD558\uACE0 \uB5BC\uC11C
      {em:\uD68C\uC804\uBCA0\uAE30} \uACF5\uACA9\n\u25CF 50% \uC774\uD558\uC5D0\uC11C
      \uB193\uC73C\uBA74 \uCDE8\uC18C, 50%\uB97C \uB118\uACA8 \uCC28\uC9D5\uD558\uBA74
      \uACF5\uACA9\n\u25CF \uCC28\uC9D5\uD560\uC218\uB85D {pos:\uD53C\uD574\uC640
      \uACF5\uACA9 \uBC94\uC704 \uC99D\uAC00}\n\u25CF \uCD5C\uB300 \uCC28\uC9D5 \uC2DC
      \uCD5C\uC18C \uCC28\uC9D5 \uB300\uBE44 \uD53C\uD574 \uC57D {val:1.67\uBC30},
      \uACF5\uACA9 \uD06C\uAE30 {val:2\uBC30}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688882
    m_Localized: "\uC870\uC900 \uBC29\uD5A5\uC73C\uB85C \uB3CC\uC9C4\uD558\uBA70
      \uC804\uBC29\uC758 \uC801\uC744 \uCC0C\uB985\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688883
    m_Localized: "\u25CF \uC870\uC900 \uBC29\uD5A5\uC73C\uB85C {em:\uB3CC\uC9C4}\uD558\uBA70
      \uC804\uBC29\uC758 \uC801\uC744 \uCC0C\uB974\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688884
    m_Localized: "\uD654\uC5FC\uAD6C\uB97C \uBC1C\uC0AC\uD574 \uC801\uC911 \uC9C0\uC810
      \uC8FC\uBCC0\uC5D0 \uD53C\uD574\uB97C \uC8FC\uACE0 [[\uD654\uC0C1]]\uC744 \uB0A8\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688885
    m_Localized: "\u25CF \uC870\uC900 \uBC29\uD5A5\uC73C\uB85C \uD654\uC5FC\uAD6C
      \uBC1C\uC0AC\n\u25CF \uC801\uC911 \uC9C0\uC810 \uC8FC\uBCC0\uC758 \uC801\uC5D0\uAC8C
      [[\uD654\uC5FC \uD53C\uD574]]\uB9CC\uD07C \uBC94\uC704 \uD53C\uD574\uB97C \uC8FC\uACE0
      [[\uD654\uC0C1]] {val:3\uC911\uCCA9} \uBD80\uC5EC"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688886
    m_Localized: "\uC9C0\uC815\uD55C \uC704\uCE58\uC5D0 \uC7A0\uC2DC \uD6C4 \uD070
      \uD3ED\uBC1C\uC744 \uC77C\uC73C\uD0B5\uB2C8\uB2E4. \uC801\uC758 [[\uD654\uC0C1]]\uC744
      \uBAA8\uB450 \uC18C\uBAA8\uD558\uBA70, \uC911\uCCA9\uC774 \uB9CE\uC744\uC218\uB85D
      \uAC15\uD574\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688887
    m_Localized: "\uCEE4\uC11C \uC704\uCE58\uC5D0\uC11C 0.6\uCD08 \uD6C4 \uD3ED\uBC1C\uD569\uB2C8\uB2E4.
      \uD654\uC5FC \uACF5\uACA9\uB825\uC5D0 \uBE44\uB840\uD55C \uD53C\uD574\uB97C
      \uC8FC\uACE0, \uC801\uC758 \uD654\uC0C1\uC744 \uBAA8\uB450 \uC18C\uBAA8\uD574
      \uC911\uCCA9\uB2F9 \uCD94\uAC00 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688888
    m_Localized: "\uC2DC\uC57C \uC548\uC758 \uBD88\uD0C0\uB294 \uC801\uB4E4\uC758
      [[\uD654\uC0C1]]\uC744 \uC77C\uBD80 \uC18C\uBAA8\uD574 \uD3ED\uBC1C\uC2DC\uD0B5\uB2C8\uB2E4.
      \uD3ED\uBC1C\uC740 \uC8FC\uBCC0 \uC801\uB3C4 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688889
    m_Localized: "\u25CF \uC2DC\uC57C \uC548\uC758 [[\uD654\uC0C1]] \uC0C1\uD0DC\uC778
      \uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uD3ED\uBC1C \uBC1C\uC0DD\n\u25CF \uB300\uC0C1\uB9C8\uB2E4
      [[\uD654\uC0C1]] \uCD5C\uB300 {val:5\uC911\uCCA9}\uC744 \uC18C\uBAA8\uD574
      \uD3ED\uBC1C \uD53C\uD574\n\u25CF \uC8FC\uBCC0 \uC801\uC5D0\uAC8C\uB3C4 \uB3D9\uC77C\uD55C
      \uD53C\uD574\n\u25CF \uD3ED\uBC1C \uC9C0\uB984 {val:5\uCE78}"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688890
    m_Localized: "\uC774\uB3D9 \uBC29\uD5A5\uC73C\uB85C \uBE60\uB974\uAC8C \uB300\uC2DC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688891
    m_Localized: "\uAF43\uC78E\uC744 \uD769\uBFCC\uB9AC\uBA70 \uC5F0\uC18D\uC73C\uB85C
      \uBCB1\uB2C8\uB2E4. \uB9C8\uC9C0\uB9C9 \uACF5\uACA9\uC740 \uB354 \uBA40\uB9AC
      \uB098\uC544\uAC00\uBA70 \uAC15\uD558\uAC8C \uBCA0\uC5B4\uB0C5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688892
    m_Localized: "\u25CF \uAF43\uC78E\uC744 \uD769\uBFCC\uB9AC\uBA70 {val:3\uC5F0\uC18D}
      \uBCA0\uAE30\n\u25CF \uC138 \uBC88\uC9F8 \uACF5\uACA9\uC740 \uB354 \uAE38\uAC8C
      \uC804\uC9C4\uD558\uBA70 \uAC15\uD558\uAC8C \uBCA0\uC5B4\uB0B8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688893
    m_Localized: "[[\uAC1C\uD654]] \uC911\uC5D0\uB294 \uB113\uC740 \uCC38\uACA9\uC744
      \uBE60\uB974\uAC8C \uC774\uC5B4\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688894
    m_Localized: "\u25CF [[\uAC1C\uD654]] \uC911 \uAE30\uBCF8 \uACF5\uACA9\uC774
      \uB113\uC740 \uCC38\uACA9\uC73C\uB85C \uBCC0\uD568\n\u25CF \uCC38\uACA9 \uBAA8\uC591\uC740
      \uBC14\uB85C \uC804 \uACF5\uACA9\uACFC \uACB9\uCE58\uC9C0 \uC54A\uAC8C \uBC14\uB01C\n\u25CF
      \uC9E7\uC740 \uAC04\uACA9\uC73C\uB85C \uBE60\uB974\uAC8C \uC5F0\uC18D \uC0AC\uC6A9
      \uAC00\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688895
    m_Localized: "\uC7A0\uC2DC [[\uAC1C\uD654]]\uD558\uC5EC \uACF5\uACA9\uB825\uACFC
      \uACF5\uACA9\xB7\uC774\uB3D9 \uC18D\uB3C4\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4.
      \uAE30\uBCF8 \uACF5\uACA9\uC774 \uB113\uC740 \uCC38\uACA9\uC73C\uB85C \uBC14\uB00C\uACE0,
      \uB300\uC2DC \uACBD\uB85C\uC5D0\uB3C4 \uCC38\uACA9\uC744 \uB0A8\uAE41\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688896
    m_Localized: "\uBC88\uAC1C \uCC3D\uC73C\uB85C \uC5F0\uC18D \uACF5\uACA9\uD574
      [[\uC804\uAE30 \uC18D\uC131]]\uC744 \uCD95\uC801\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606285688897
    m_Localized: "\uB0A8\uC740 \uD0C4\uC57D\uC744 \uBAA8\uB450 \uC18C\uBAA8\uD574
      \uBD80\uCC44\uAF34\uB85C \uB09C\uC0AC\uD569\uB2C8\uB2E4. \uD0C4\uD658\uC5D0
      \uB9DE\uC740 \uC801\uC740 \uBC00\uB824\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883136
    m_Localized: "\uD0C4\uC57D\uC774 \uC5C6\uC5B4 \uACF5\uACA9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883137
    m_Localized: "\uD0C4\uC57D\uC774 \uC5C6\uC5B4 \uACF5\uACA9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883138
    m_Localized: "\uD0C4\uC57D\uC744 \uC18C\uBAA8\uD574 \uC801\uC744 \uBC00\uCCD0\uB0B4\uB294
      \uD0C4\uD658\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4. \uD0C4\uC57D\uC774 \uC5C6\uC73C\uBA74
      \uACF5\uACA9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883139
    m_Localized: "\uBB34\uAE30\uB97C \uB358\uC838 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C
      \uC8FC\uACE0 \uBC00\uCCD0\uB0C5\uB2C8\uB2E4. \uB358\uC9C4 \uBB34\uAE30\uB294
      {neg:\uC601\uAD6C\uD788 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4}."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883140
    m_Localized: "\uAC80\uC744 \uC5F0\uC18D\uC73C\uB85C \uD718\uB458\uB7EC \uC804\uBC29\uC758
      \uC801\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883141
    m_Localized: "\uAE30\uBCF8 \uACF5\uACA9 \uC2DC <color=#8A5A10>10% \uD655\uB960</color>\n<color=#197A67>\uD53C\uD574\uB7C9
      3\uBC30</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883142
    m_Localized: "<color=#A8324A>\uBC1B\uB294 \uD53C\uD574 2\uBC30</color>\n<color=#197A67>\uACF5\uACA9
      \uC18D\uB3C4 +40%</color>\n<color=#197A67>\uC774\uB3D9 \uC18D\uB3C4 +20%</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 50606289883143
