  - m_Id: 46294717337612
    m_Localized: "\uC2A4\uD0AC \uD53C\uD574\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 46294717337613
