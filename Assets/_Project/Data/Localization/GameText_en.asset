  - m_Id: 139235326595085
    m_Localized: On defeating an enemy,
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595086
    m_Localized: On defeating an enemy,
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595087
    m_Localized: When taking damage,
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595088
    m_Localized: When taking damage,
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595089
    m_Localized: On defeating an enemy,
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595090
    m_Localized: When taking damage,
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595091
    m_Localized: "\u25CF A [[\uCE58\uBA85\uD0C0]] against an enemy with [[\uD654\uC0C1]]
      applies {burn_stacks} stacks of [[\uD654\uC0C1]]\n\u25CF Cooldown {cooldown}"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595092
    m_Localized: "\u25CF On a [[\uCE58\uBA85\uD0C0]], gain {chance} [[\uCE58\uBA85\uD0C0
      \uD655\uB960]] for {duration}\n\u25CF Another critical hit {pos:refreshes the
      duration}"
    m_Metadata:
      m_Items: []
  - m_Id: 139235326595093
    m_Localized: "\u25CF On a non-critical hit, gain {chance_per_stack} [[\uCE58\uBA85\uD0C0
      \uD655\uB960]]\n\u25CF Stacks up to {maximum_stacks} times, totaling {maximum_chance}\n\u25CF
      A critical hit {neg:resets the accumulated bonus}"
    m_Metadata:
      m_Items: []
