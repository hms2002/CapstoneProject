  m_TableData:
  - m_Id: 8714620928
    m_Localized: <color=#96DCFA>No reloading. Once the six shots are spent, all that
      remains is to throw this odd lump of iron.</color>
    m_Metadata:
      m_Items: []
  - m_Id: 8903364608
    m_Localized: All attacks are guaranteed critical hits while current HP is {threshold}
      or lower.
    m_Metadata:
      m_Items: []
  - m_Id: 8911753216
    m_Localized: Welcome, hero! Got plenty of shiny magic stones with you today?
    m_Metadata:
      m_Items: []
