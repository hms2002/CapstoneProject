  m_Script: {fileID: 11500000, guid: 5b97b3d6f35b4cb69c44bb7ca0af5e21, type: 3}
  m_Name: IntroSequence_Default
  m_EditorClassIdentifier: Assembly-CSharp::TitleIntroSequenceSO
  slides:
  - image: {fileID: 21300000, guid: 924ddefcebfa19c4abd287ddf6a9e1b4, type: 3}
    text: "\uC624\uB798\uC804. \uC778\uAC04\uACFC \uC774\uC885\uC871\uC758 \uAC08\uB4F1\uC774
      \uC810\uCC28 \uACA9\uD574\uC838 \uB9C8\uCE68\uB0B4 \uCD5C\uACE0\uC870\uC5D0
      \uB2EC\uD588\uB2E4."
  - image: {fileID: 21300000, guid: 43350c648d0a5b3408f4b3594b695d51, type: 3}
    text: "\uB2F9\uC7A5\uC774\uB77C\uB3C4 \uD070 \uC2F8\uC6C0\uC774 \uBC8C\uC5B4\uC9C8
      \uB4EF\uD588\uB358 \uADF8\uB54C. \uD640\uC5F0\uD788 \uB098\uD0C0\uB09C '\uB9C8\uC655'\uC774
      \uC774\uC885\uC871\uC744 \uADDC\uD569\uD574 \uAC70\uB300\uD55C \uC138\uB825\uC744
      \uC138\uC6B0\uB2C8, \uC0AC\uB78C\uB4E4\uC740 \uC774\uB97C \uB9C8\uC655\uAD70\uC774\uB77C
      \uBD88\uB800\uB2E4."
  - image: {fileID: 21300000, guid: c6c4176a9140c764ab4a8972c979673c, type: 3}
    text: "\uBD88\uC548\uC5D0 \uBE60\uC9C4 \uC778\uAC04\uB4E4\uC740 \uB2F9\uC2E0\uC758
      \uC18C\uAFC9\uCE5C\uAD6C\uB97C \uC6A9\uC0AC\uB85C \uBC1C\uD0C1\uD588\uB2E4.
      \uD558\uC9C0\uB9CC \uB9C8\uC655\uAD70\uC758 \uC704\uD611\uC744 \uC870\uAE30\uC5D0
      \uB9C9\uACE0\uC790 \uD640\uB85C \uB9C8\uC655\uC131\uC73C\uB85C \uD5A5\uD588\uB358
      \uCE5C\uAD6C\uB294, \uADF8\uACF3\uC5D0\uC11C \uAC10\uAC10\uBB34\uC18C\uC2DD\uC73C\uB85C
      \uC2E4\uC885\uB418\uACE0 \uB9D0\uC558\uB2E4."
  - image: {fileID: 21300000, guid: defed05ae5fca6e40968a28bb7a85a87, type: 3}
    text: "\uADF8\uB9AC\uACE0 \uD604\uC7AC. \uC0AC\uB77C\uC9C4 \uC18C\uAFC9\uCE5C\uAD6C\uC758
      \uD754\uC801\uC744 \uCAD3\uC544, \uB2F9\uC2E0 \uB610\uD55C \uB9C8\uC655\uC131\uC758
      \uC785\uAD6C\uC5D0 \uB3C4\uB2EC\uD558\uBA70 \uC774\uC57C\uAE30\uB294 \uC2DC\uC791\uB41C\uB2E4."
  secondsPerCharacter: 0.05
