  slides:
  - image: {fileID: 21300000, guid: 8b3817e5d6f7b064389312e4b0000cb6, type: 3}
    text: "\uB9C8\uC655\uC740 \uC4F0\uB7EC\uC84C\uB2E4."
  - image: {fileID: 21300000, guid: 813f6908a2392d04bac648d97239c952, type: 3}
    text: "\uC655\uAD6D\uC744 \uC704\uD611\uD558\uB358 \uC774\uC885\uC871\uC740 \uB9C8\uC655\uC758
      \uBD80\uC7AC\uB85C \uBFD4\uBFD4\uC774 \uD769\uC5B4\uC84C\uB2E4. \uD769\uC5B4\uC9C4
      \uC774\uC885\uC871\uC774 \uAC01\uC9C0\uC5D0\uC11C \uBB38\uC81C\uB97C \uC77C\uC73C\uD0A8\uB2E4\uB294
      \uC18C\uC2DD\uB3C4 \uB4E4\uB824\uC654\uB2E4."
  - image: {fileID: 21300000, guid: f9c20d8f41913e14d93d1e304ed03f32, type: 3}
    text: "\uB2F9\uC2E0\uC758 \uCE5C\uAD6C\uAC00 \uC5B4\uC9F8\uC11C \uB9C8\uC655\uC744
      \uC790\uCC98\uD588\uB294\uC9C0 \uC544\uC9C1 \uBAA8\uB974\uC9C0\uB9CC, \uC5B4\uCA0C\uAC70\uB098
      \uC655\uAD6D\uC740 \uADC0\uD658\uD55C \uB2F9\uC2E0\uC744 \uD658\uC601\uD588\uB2E4."
  - image: {fileID: 21300000, guid: e58705b6d8e350149a322f1995a73886, type: 3}
    text: "\uD558\uC9C0\uB9CC... \uC815\uB9D0 \uC774\uAC83\uC73C\uB85C \uB41C \uAC78\uAE4C?"
