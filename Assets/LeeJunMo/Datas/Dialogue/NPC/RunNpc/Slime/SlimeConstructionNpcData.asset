  featureKind: 0
  constructionNotStarted:
    lines:
    - text: "\uC5B4\uC774, \uAC70\uAE30! \uC5EC\uAE34 \uBABB \uC9C0\uB098\uAC00!"
      duration: 2.5
      theme:
        useCustomColors: 0
        borderColor: {r: 0, g: 0, b: 0, a: 1}
        fillColor: {r: 1, g: 1, b: 1, a: 0.52}
        fontColor: {r: 0, g: 0, b: 0, a: 1}
    - text: "\uC544\uB2C8. \uB531\uD788 \uB9C9\uB294 \uAC8C \uC544\uB2C8\uB77C \uAE38\uC774
        \uC5C6\uC5B4."
      duration: 2
      theme:
        useCustomColors: 0
        borderColor: {r: 0, g: 0, b: 0, a: 1}
        fillColor: {r: 1, g: 1, b: 1, a: 0.52}
        fontColor: {r: 0, g: 0, b: 0, a: 1}
    - text: "\uC608\uC804 \uC6A9\uC0AC\uAC00 \uB0A0\uB6F0\uBA74\uC11C \uAE38\uC774
        \uC644\uC804\uD788 \uB9C9\uD614\uAC70\uB4E0."
      duration: 2.5
      theme:
        useCustomColors: 0
        borderColor: {r: 0, g: 0, b: 0, a: 1}
        fillColor: {r: 1, g: 1, b: 1, a: 0.52}
        fontColor: {r: 0, g: 0, b: 0, a: 1}
    - text: "\uACF5\uC0AC \uB300\uAE08\uC774 \uC544\uC9C1 \uC548 \uB4E4\uC5B4\uC640\uC11C
        \uC791\uC5C5\uC774 \uBD88\uAC00\uB2A5\uD574."
      duration: 2.5
      theme:
        useCustomColors: 0
        borderColor: {r: 0, g: 0, b: 0, a: 1}
        fillColor: {r: 1, g: 1, b: 1, a: 0.52}
        fontColor: {r: 0, g: 0, b: 0, a: 1}
    choices:
    - label: "\uC544, \uADF8\uB798? \uADF8\uB7FC \uADF8\uB0E5 \uAC08\uAC8C."
      hideWhenActionUnavailable: 0
      action: 0
      responseLines: []
      unavailableResponseLines: []
    - label: "\uADF8 \uACF5\uC0AC \uB300\uAE08\uC744 \uB0B4\uAC00 \uB0B4\uC904 \uC218\n\uC788\uB294\uB370. \uB9C8\uC815\uC11D -50"
      hideWhenActionUnavailable: 1
      action: 1
      responseLines:
      - text: "\uC815\uB9D0\uB85C? \uADF8\uB7FC \uACF5\uC0AC\uB97C \uC2DC\uC791\uD560\uAC8C!
          \uC544\uB9C8 3\uC77C \uD6C4 \uC988\uC74C \uC624\uBA74 \uB420 \uAC70\uC57C."
        duration: 2
        theme:
